  "mcpServers": {
    "ld-vocab": {
      "command": "java",
      "args": [
        "-jar",
        "${LD_MCP_JAR:-tools/ld-mcp-vocab.jar}",
        "--ontologies",
        "src/main/resources",
        "--rules",
        "src/main/resources/be/vlaanderen/ssnsosa/data/id/rule/domain-range-subproperty.rules",
        "--generate-shapes",
