    rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn-2023/#DOLCE-alignment> ;
    rdfs:comment "Part of SSN/SOSA 2023 (W3C Working Draft, 2026-10-07)."@en .

<http://www.w3.org/ns/sosa/bfo> a owl:Ontology ;
    dcterms:title "SOSA alignment with BFO and the Common Core Ontologies"@en ;
    owl:versionIRI <http://www.w3.org/ns/sosa/2023/bfo> ;
    dcterms:references
        <http://www.w3.org/ns/sosa/> ,
        <http://purl.obolibrary.org/obo/> ,
        <https://www.commoncoreontologies.org/> ;
    dcterms:source <https://github.com/w3c/sdw-sosa-ssn/blob/gh-pages/ssn/rdf/ontology/alignments/sosa-bfo.ttl> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn-2023/#BFO-alignment> ;
    rdfs:comment "Part of SSN/SOSA 2023 (W3C Working Draft, 2026-10-07)."@en .

<http://www.w3.org/ns/sosa/ido> a owl:Ontology ;
    dcterms:title "SOSA alignment with ISO 23726-3 Industrial Data Ontology (IDO)"@en ;
    owl:versionIRI <http://www.w3.org/ns/sosa/2023/ido> ;
    dcterms:references
        <http://www.w3.org/ns/sosa/> ,
        <http://rds.posccaesar.org/ontology/lis14/rdl/> ,
        <http://rds.posccaesar.org/ontology/lis14/ont/core/> ;
    dcterms:source <https://github.com/w3c/sdw-sosa-ssn/blob/gh-pages/ssn/rdf/ontology/alignments/sosa-ido.ttl> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn-2023/#IDO-alignment> ;
    rdfs:comment "Part of SSN/SOSA 2023 (W3C Working Draft, 2026-10-07)."@en .

<https://example.org/sosa-sdo-mapping> a owl:Ontology ;
    dcterms:title "SOSA alignment with schema.org (preliminary)"@en ;
    dcterms:references
        <http://www.w3.org/ns/sosa/> ,
        <https://schema.org/> ;
    dcterms:source <https://github.com/w3c/sdw-sosa-ssn/blob/gh-pages/ssn/rdf/ontology/alignments/sosa-sdo.ttl> ;
    rdfs:comment "Preliminary module of SSN/SOSA 2023, still with an example.org ontology IRI."@en .
