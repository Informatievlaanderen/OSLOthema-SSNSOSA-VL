# OGC HY_Features (HydroFeature package), volledig gedereferenced van
# https://www.opengis.net/def/schema/hy_features/hyf (OGC-definitieserver) door scripts/hyfeatures_ophalen.py.
# Niet manueel bewerken; opnieuw ophalen met het script.

@prefix bodies: <http://www.opengis.net/def/entities/bodies/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix hyf: <https://www.opengis.net/def/schema/hy_features/hyf/> .
@prefix hyfeatures: <https://www.opengis.net/def/schema/hy_features/> .
@prefix ns10: <http://www.opengis.net/def/metamodel/ogc-na/> .
@prefix ns11: <http://www.opengis.net/def/status/> .
@prefix ns349: <http://www.opengis.net/ont/> .
@prefix ns353: <http://www.opengis.net/def/metamodel/featuretypes/> .
@prefix ns7: <http://www.opengis.net/def/metamodel/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hyf: a skos:Collection ;
    rdfs:comment "This is the collection viewpoint of this application schema, consisting of sub-collections of feature types, properties and codelists defined by the application schema."@en ;
    skos:definition "" ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "" .

<https://www.opengis.net/def/schema/hy_features/hyf/CodeLists/> a skos:Collection ;
    rdfs:label "Code Lists" ;
    rdfs:comment "All Code Lists declared in this Application Schema" ;
    skos:definition "Code Lists" ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "Code Lists" .

<https://www.opengis.net/def/schema/hy_features/hyf/FeatureTypes/> a skos:Collection ;
    rdfs:label "Feature Types" ;
    rdfs:comment "All feature types declared in this Application Schema." ;
    skos:definition "Feature Types" ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "Feature Types" .

hyf:HY_Canal a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Canal" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Canal?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Canal?_profile=alt> ;
    skos:broader hyf:HY_WaterBody ;
    skos:broaderTransitive hyf:HY_WaterBody ;
    skos:definition "The HY_Canal feature type defines the existence of body of surface water, participating in a hydrographic network, special due to its artificial origin (man-made)."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Canal" .

hyf:HY_Channel a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Channel" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Channel?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Channel?_profile=alt> ;
    skos:broader hyf:HY_Depression ;
    skos:broaderTransitive hyf:HY_Depression ;
    skos:definition """The HY_Channel feature type specializes the HY_Depression class with respect to a natural or man-made, open or closed channel through or along which water may or may not flow. A channel is part of the network of channels and depressions which forms the connecting system for the hydrographic network; a channel may have vertical sections at right angles to the main (average) direction of flow or along its centerline.

HY_Channel has an association indicating the channelNetwork in which it participates. It carries the associations: stream, bedProfileTransversal and bedProfileLongitudinal. HY_Channel inherits from generalization the confinedWaterBody association and the outflow-at-benchmark constraint. An outlet-at-profile constraint emphasizes the recognition of vertical section as the outlet of the catchment that is realized by the channel network."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Channel" .

hyf:HY_ChannelNetwork a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_ChannelNetwork" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_ChannelNetwork?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_ChannelNetwork?_profile=alt> ;
    skos:definition """The HY_ChannelNetwork feature type specializes the HY_HydroNetwork realization defined in the Hydro Feature core model, specifically as an aggregate of surface depressions and surface channels which continuously or periodically contain water, without imposing a particular drainage pattern. This allows representation of the network, even if logically connected features are not connected at the representation level. If the realized catchment is connected with other catchments via hydro nexuses, the channel network is considered connected to the channel network realizing these catchments.

HY_ChannelNetwork has surfaceDepression and surfaceChannel associations, and carries a drainagePattern attribute; it inherits through generalization the shape attribute, the realizedCatchment association as well as flowpath, catchmentDivide and catchmentArea associations. Depending on the application, the channel network and the related features may be described by suitable attributes. A channel-flowpath constraint is defined to support the recognition of the channel as flowpath realizing the catchment."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_ChannelNetwork" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_CrossSection a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_CrossSection" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_CrossSection?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_CrossSection?_profile=alt> ;
    skos:definition """The HY_CrossSection feature type conceptualizes the segmentation of a waterbody or a containing channel through vertical sections. Taking into account the conceptual separation of a watercourse, the cross section concept refers to both the cross section of a waterbody orthogonal to the direction of flow, and to the transversal bed profile of a channel.

A cross section associates a crossSectionPoint which should be used to identify a permanent reference location at a vertical section which realizes the conceptual hydro nexus of the catchment realized by the associated channel or waterbody."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_CrossSection" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_Estuary a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Estuary" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Estuary?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Estuary?_profile=alt> ;
    skos:broader hyf:HY_WaterBody ;
    skos:broaderTransitive hyf:HY_WaterBody ;
    skos:definition "The HY_Estuary feature type defines the existence of body of surface water, participating in a hydrographic network, special due to branching and its interaction with the open sea."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Estuary" .

hyf:HY_HydrographicNetwork a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_HydrographicNetwork" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydrographicNetwork?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydrographicNetwork?_profile=alt> ;
    skos:definition """The HY_HydrographicNetwork feature type specializes the HY_HydroNetwork realization defined in the Hydro Feature core model, specifically as an aggregate of permanent or temporary bodies standing in depressions or moving in channels. If the realized catchment is connected with other catchments via hydro nexuses, the hydrographic network is considered connected to the network realizing these catchments. This allows representation of the network, even if logically connected features are not connected at the representation level. If required, an application focused on surface-waterbodies contained in channels or depressions may use the defined relationships to describe the realization of a catchment by the hydrographic network, or network parts associated with the channel network.

HY_HydrographicNetwork has a networkWaterBody association. Through generalization, it inherits the shape attribute and the realizedCatchment association as well as flowpath, catchmentDivide and catchmentArea associations, and. A waterbody-flowpath constraint supports the recognition of the waterbody as a flowpath realizing the catchment."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_HydrographicNetwork" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_HydrometricFeature a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_HydrometricFeature" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydrometricFeature?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydrometricFeature?_profile=alt> ;
    skos:definition """The HY_HydrometricFeature feature type provides a concept of a monitoring station at which data on water are obtained that realizes the catchment either separately or as part of the hydrometric network (Figure 45).

HY_HydrometricFeature has associations for the hydrometricNetwork in which it participates, and a positionOnRiver. An outlet-at-station constraint emphasizes the recognition of a monitoring station as outlet of the catchment that is realized by the hydrometric network."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_HydrometricFeature" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_HydrometricNetwork a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_HydrometricNetwork" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydrometricNetwork?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydrometricNetwork?_profile=alt> ;
    skos:definition """The HY_HydrometricNetwork feature type specializes the HY_HydroNetwork realization specifically as an aggregate of hydrometric features.

HY_HydrometricNetwork has a networkStation association, and inherits through generalization the shape attribute, the realizedCatchment, flowpath, catchmentDivide and catchmentArea associations."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_HydrometricNetwork" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_Impoundment a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Impoundment" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Impoundment?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Impoundment?_profile=alt> ;
    skos:broader hyf:HY_WaterBody ;
    skos:broaderTransitive hyf:HY_WaterBody ;
    skos:definition "The HY_Impoundment feature type defines the existence of body of surface water, participating in a hydrographic network, special due to be formed by collecting water, as by a dam."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Impoundment" .

hyf:HY_Lagoon a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Lagoon" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Lagoon?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Lagoon?_profile=alt> ;
    skos:broader hyf:HY_WaterBody ;
    skos:broaderTransitive hyf:HY_WaterBody ;
    skos:definition "The HY_Lagoon feature type defines the existence of body of surface water, participating in a hydrographic network, special due to its shallow depth and interaction with the open sea."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Lagoon" .

hyf:HY_Lake a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Lake" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Lake?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Lake?_profile=alt> ;
    skos:broader hyf:HY_WaterBody ;
    skos:broaderTransitive hyf:HY_WaterBody ;
    skos:definition "The HY_Lake feature type defines the existence of body of surface water, participating in a hydrographic network, special due to its considerable size."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Lake" .

hyf:HY_LongitudinalSection a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_LongitudinalSection" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_LongitudinalSection?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_LongitudinalSection?_profile=alt> ;
    skos:definition """The HY_LongitudinalSection feature type conceptualizes the segmentation of a waterbody or a containing channel through vertical sections. Taking into account the conceptual separation of a watercourse, the longitudinal section concept refers to both the vertical section of a waterbody along its centerline, and to the longitudinal bed profile of a channel.

A longitudinal section associates a longitudalinalSectionPoint which should be used to identify a permanent reference location at a vertical section which realizes the conceptual hydro nexus of the catchment realized by the associated channel or waterbody."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_LongitudinalSection" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_Reservoir a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Reservoir" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Reservoir?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Reservoir?_profile=alt> ;
    skos:definition """The HY_Reservoir feature type describes the water body, either natural or man-made, used for storage, regulation and control of water resources. The reservoir concept refers to a volume of water managed in zones between operating levels.

HY_Reservoir associates to a reservoir the storedWaterBody and a reservoirZone."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Reservoir" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_River a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Stream"@en ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_River?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_River?_profile=alt> ;
    skos:broader hyf:HY_WaterBody ;
    skos:broaderTransitive hyf:HY_WaterBody ;
    skos:definition "The HY_River feature type defines the existence of body of surface water, participating in a hydrographic network, special due to its property to permanently or temporarily flow."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Stream"@en .

hyf:HY_WaterBodyStratum a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_WaterBodyStratum" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_WaterBodyStratum?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_WaterBodyStratum?_profile=alt> ;
    skos:definition """The HY_WaterBodyStratum feature type describes a horizontal layer in a stratified waterbody determined by differences in thermal or salinity characteristics or by oxygen or nutrient content, or by virtual storage zones of a reservoir.

HY_WaterBodyStratum carries the properties: stratumType and benchmark."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_WaterBodyStratum" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_Water_LiquidPhase a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Water_LiquidPhase" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Water_LiquidPhase?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Water_LiquidPhase?_profile=alt> ;
    skos:definition """The HY_Water_LiquidPhase feature type provides a simple concept of the accumulation of water in waterbodies. This definition refers to the matter accumulated to a mass of water. In its liquid form water is considered accumulated in waterbodies. The accumulation of water in the atmosphere or below the land surface, e.g. rain, soil moisture or groundwater, is not in scope of this standard, as well as the accumulation of snow and ice in glaciers which is subject of glaciology science.

Contextually related information models may use the HY_Water_LiquidPhase feature type to build relationships to an accumulating waterbody, and ultimately to the catchment realized either by the waterbody or by the network of which the waterbody is part.

HY_Water_LiquidPhase has an association with the accumulatingWaterBody which may be used to identify the waterbody (as part of the hydrographic network) where liquid water is accumulated."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Water_LiquidPhase" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_Water_SolidPhase a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Water_SolidPhase" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Water_SolidPhase?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Water_SolidPhase?_profile=alt> ;
    skos:definition """The HY_Water_SolidPhase feature type provides a simple concept of the accumulation of water in waterbodies. This definition refers to the matter accumulated to a mass of water. In its solid form water is considered accumulated in water bodies after melting, or as a layer of ice or snow on an open waterbody. The accumulation of water in the atmosphere or below the land surface, e.g. rain, soil moisture or groundwater, is not in scope of this standard, as well as the accumulation of snow and ice in glaciers which is subject of glaciology science.

Contextually related information models may use the HY_Water_LiquidPhase and HY_Water_SolidPhase feature types to build relationships to an accumulating waterbody, and ultimately to the catchment realized either by the waterbody or by the network of which the waterbody is part.

HY_Water_LiquidPhase has an association with the accumulatingWaterBody; HY_Water_SolidPhase has associations with the water from snowmelt and coveredWaterBody. These associations may be used to identify the waterbody (as part of the hydrographic network) where liquid water is accumulated."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Water_SolidPhase" ;
    skos:topConceptOf hyfeatures:hyf .

<https://www.opengis.net/def/schema/hy_features/hyf/Properties/> a skos:Collection ;
    rdfs:label "Feature Properties" ;
    rdfs:comment "All properties declared in this Application Schema." ;
    skos:definition "Feature Properties" ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "Feature Properties" .

hyf:HY_CartographicRealization a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_CartographicRealization" ;
    ns353:hasProperty geo:hasGeometry,
        hyf:realizedCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_CartographicRealization?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_CartographicRealization?_profile=alt> ;
    rdfs:subClassOf hyf:HY_CatchmentRealization ;
    skos:broader hyf:HY_CatchmentRealization ;
    skos:broaderTransitive hyf:HY_CatchmentRealization ;
    skos:definition """The HY_CartographicRealization feature type realizes a catchment as set of separate cartographic layers or maps, displaying a network of hydrologic features which may be connected at the representation level, or not.

Specializing HY_CatchmentRealization, it inherits from generalization the shape attribute and the realizedCatchment association."""@en,
        "The HY_CartographicRealization feature type realizes a catchment as set of separate cartographic layers or maps, displaying a network of hydrologic features which may be connected at the representation level, or not.  Specializing HY_CatchmentRealization, it inherits from generalization the shape attribute and the realizedCatchment association."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_CartographicRealization" .

hyf:HY_CatchmentAggregate a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_CatchmentAggregate" ;
    ns353:hasProperty hyf:catchmentRealization,
        hyf:code,
        hyf:conjointCatchment,
        hyf:containedCatchment,
        hyf:containingCatchment,
        hyf:endorheicDrainage,
        hyf:exorheicDrainage,
        hyf:inflow,
        hyf:lowerCatchment,
        hyf:name,
        hyf:outflow,
        hyf:upperCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_CatchmentAggregate?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_CatchmentAggregate?_profile=alt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/endorheicDrainage ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_InteriorCatchment ;
            owl:onProperty hyf:endorheicDrainage ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/exorheicDrainage ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_DendriticCatchment ;
            owl:onProperty hyf:exorheicDrainage ],
        hyf:HY_Catchment ;
    skos:broader hyf:HY_Catchment ;
    skos:broaderTransitive hyf:HY_Catchment,
        hyf:HY_HydroFeature ;
    skos:definition """The HY_CatchmentAggregate feature type (Figure 30) specializes the HY_Catchment type as a set of non-overlapping dendritic and interior catchments arranged in an encompassing catchment. This can be used to describe multiple inflows into a catchment aggregate through several hydrologically discrete sub-catchments each with a single inflow, and contributing to a joined outflow of the catchment aggregate, including the 'nillable' outflow of interior catchments. Nillable is meant here to signify that the hydro nexus logically exists in the form of flow to the subsurface or atmosphere but is unknown in a given implementation.

Being a special type of the HY_Catchment, the catchment aggregate may be part of a containing catchment at the next higher level of hierarchy, which consists of similar-scale neighboring catchments. The catchment aggregate does not necessarily imply a series of nested containing catchments. It primarily allows navigation to the 'highest' level system (total drainage basin) as typically used for reporting purposes.

HY_CatchmentAggregate inherits through generalization the outflow, inflow, containingCatchment, containedCatchment, conjointCatchment, upperCatchment, lowerCatchment, and catchmentRealization properties, and has exorheicDrainage and endorheicDrainage associations."""@en,
        "The HY_CatchmentAggregate feature type (Figure 30) specializes the HY_Catchment type as a set of non-overlapping dendritic and interior catchments arranged in an encompassing catchment. This can be used to describe multiple inflows into a catchment aggregate through several hydrologically discrete sub-catchments each with a single inflow, and contributing to a joined outflow of the catchment aggregate, including the 'nillable' outflow of interior catchments. Nillable is meant here to signify that the hydro nexus logically exists in the form of flow to the subsurface or atmosphere but is unknown in a given implementation.  Being a special type of the HY_Catchment, the catchment aggregate may be part of a containing catchment at the next higher level of hierarchy, which consists of similar-scale neighboring catchments. The catchment aggregate does not necessarily imply a series of nested containing catchments. It primarily allows navigation to the 'highest' level system (total drainage basin) as typically used for reporting purposes. HY_CatchmentAggregate inherits through generalization the outflow, inflow, containingCatchment, containedCatchment, conjointCatchment, upperCatchment, lowerCatchment, and catchmentRealization properties, and has exorheicDrainage and endorheicDrainage associations."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_CatchmentAggregate" .

hyf:HY_DistanceDescription a owl:Class,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:subClassOf skos:Concept ;
    skos:broader skos:Concept ;
    skos:definition "list of general terms commonly used in hydrology to describe a spatial relationship between two locations. If required, an implementation should use terms from this code list, defined specifically to conform to a terminology common in the hydrology domain. Note that alternative code lists may be used but should be related to the terms in but should be related to the terms in this code list using an appropriate formalism."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_DistanceDescription" .

hyf:HY_DistanceFromReferent a owl:Class,
        skos:Concept ;
    ns353:hasProperty hyf:absolute,
        hyf:accuracyStatement,
        hyf:interpolative,
        hyf:precisionStatement ;
    ns10:status ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/precisionStatement ( 0:* ) " ;
            owl:allValuesFrom <http://shapechange.net/resources/ont/base#Measure> ;
            owl:onProperty hyf:precisionStatement ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/interpolative ( 0:* ) " ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty hyf:interpolative ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/absolute ( 0:* ) " ;
            owl:allValuesFrom <http://shapechange.net/resources/ont/base#Measure> ;
            owl:onProperty hyf:absolute ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/accuracyStatement ( 0:* ) " ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hyf:accuracyStatement ] ;
    skos:definition "The HY_DistanceFromReferent data type provides the distance from a located referent as an absolute or interpolative value, including simple statements on accuracy and precision of the measured position."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_DistanceFromReferent" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_HydroLocationType a owl:Class,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:subClassOf skos:Concept ;
    skos:broader skos:Concept ;
    skos:definition """terms identifying a Hydro Location determined to realize the conceptual nexus. If required, an implementation should use terms from this code list, defined specifically to conform to a terminology common in the hydrology domain. Note that alternative code lists may be used but should be related to the terms in but should be related to the terms in this code list using an appropriate formalism. 
"""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_HydroLocationType" .

hyf:HY_HydroNetwork a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_HydroNetwork" ;
    ns353:hasProperty geo:hasGeometry,
        hyf:catchmentArea,
        hyf:catchmentDivide,
        hyf:flowpath,
        hyf:realizedCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroNetwork?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroNetwork?_profile=alt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/catchmentDivide ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_CatchmentDivide ;
            owl:onProperty hyf:catchmentDivide ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/flowpath ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_FlowPath ;
            owl:onProperty hyf:flowpath ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/catchmentArea ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_CatchmentArea ;
            owl:onProperty hyf:catchmentArea ],
        hyf:HY_CatchmentRealization ;
    skos:broader hyf:HY_CatchmentRealization ;
    skos:broaderTransitive hyf:HY_CatchmentRealization ;
    skos:definition """The HY_HydroNetwork feature type realizes a catchment as a network of connected hydrologic features. Such a network realizes the hierarchical network of logically connected catchments contained in a larger catchment. It may be a sequence of flowpaths, an aggregate of catchment areas or a mesh of catchment divides.

HY_HydroNetwork feature type specializes HY_CatchmentRealization. Through generalization it inherits the shape and the realizedCatchment properties, and carries the associations flowpath, catchmentDivide and catchmentArea. The optional shape of the is usually given through the individual geometry of the network parts."""@en,
        "The HY_HydroNetwork feature type realizes a catchment as a network of connected hydrologic features. Such a network realizes the hierarchical network of logically connected catchments contained in a larger catchment. It may be a sequence of flowpaths, an aggregate of catchment areas or a mesh of catchment divides.  HY_HydroNetwork feature type specializes HY_CatchmentRealization. Through generalization it inherits the shape and the realizedCatchment properties, and carries the associations flowpath, catchmentDivide and catchmentArea. The optional shape of the is usually given through the individual geometry of the network parts."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_HydroNetwork" .

hyf:HY_NameUsage a owl:Class,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:subClassOf skos:Concept ;
    skos:broader skos:Concept ;
    skos:definition "terms used to indicate the type of name usage. If required, an implementation should use terms from this code list, defined specifically to conform to a terminology common in the hydrology domain. Note that alternative code lists may be used but should be related to the terms in but should be related to the terms in this code list using an appropriate formalism."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_NameUsage" .

hyf:absolute a owl:DatatypeProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range <http://shapechange.net/resources/ont/base#Measure> ;
    skos:definition "geometric expression of the distance from a located referent. An implementation may use the types described in ISO 19103: Conceptual Schema."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "absolute" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:accuracyStatement a owl:DatatypeProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range xsd:string ;
    skos:definition "simple statement whether the distance value agrees with the value accepted as being true.  This statement assumes that all known corrections have been applied. An implementation may use the types described in ISO 19103: Conceptual Schema."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "accuracyStatement" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:catchmentArea a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_CatchmentArea ;
    skos:definition "catchment area that participates in the network."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "catchmentArea" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:catchmentDivide a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_CatchmentDivide ;
    skos:definition "catchment boundary that participates in the network."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "catchmentDivide" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:contributingCatchment a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_Catchment ;
    skos:definition "identifies the catchment that contributes flow to this hydro nexus. This allows connection of a catchment's outflow to an identified inflow and to determine its position through referencing the inflow."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "contributingCatchment" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:distanceDescription a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_DistanceDescription ;
    skos:definition "term describing the distance from the feature being used as a reference. An implementation may use the HY_DistanceDescription code list. Alternatively, the types described in ISO 19103: Conceptual Schema may be used."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "distanceDescription" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:distanceExpression a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_DistanceFromReferent ;
    skos:definition "absolute or interpolative value of the distance from the feature being used as a reference, including an indication of accuracy and precision of the absolute value. An implementation may use the HY_DistanceFromReferent (data type) referencing basic types. Alternatively, the types described in ISO 19103: Conceptual Schema may be used."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "distanceExpression" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:endorheicDrainage a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_InteriorCatchment ;
    skos:definition "should be used to identify an endorheic-drained catchment, which is not, but may be temporarily connected to the enveloping catchment."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "endorheicDrainage" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:exorheicDrainage a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_DendriticCatchment ;
    skos:definition "should be used to identify an exorheic-drained catchment which is permanently connected to the encompassing catchment."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "exorheicDrainage" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:flowpath a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_FlowPath ;
    skos:definition "flowpath that participates in the network."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "flowpath" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:hydroLocationType a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_HydroLocationType ;
    skos:definition "expresses the type of the realized nexus, using a term from the HY_HydroLocationType code list, or a controlled vocabulary. Alternative code lists may be used but should be related to the terms in this code list using an appropriate formalism."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "hydroLocationType" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:interpolative a owl:DatatypeProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range xsd:double ;
    skos:definition "interpolative expression (percentage) of the distance from a located referent. An implementation may use the types described in ISO 19103: Conceptual Schema."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "interpolative" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:linearElement a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_FlowPath ;
    skos:definition "identifies a flowpath used as the linear element along which a position is assigned to a hydro-location, or any feature of interest."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "linearElement" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:locatedReferent a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_HydroLocation ;
    skos:definition "identifies an already referenced location such as a catchment outlet relative to which a position may be assigned to a feature of interest."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "locatedReferent" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:name_string a owl:DatatypeProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:domain hyf:HY_HydroFeatureName ;
    rdfs:range xsd:string ;
    skos:definition "indicates whether the name applies to a part of feature only or not, using the Boolean value type"@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "name_string" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:namesPart a owl:DatatypeProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates whether the name applies to a part of feature only or not, using the Boolean value type"@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "namesPart" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:nexusRealization a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_HydroLocation ;
    skos:definition "identifies a hydrologic feature which realizes the hydro nexus. A topological nexus realization is of lower dimension than the realization of the corresponding catchment. Example: an outflow node realizing the nexus would be of lower dimension than the flowpath edge realizing the contributing catchment."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "nexusRealization" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:precisionStatement a owl:DatatypeProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range <http://shapechange.net/resources/ont/base#Measure> ;
    skos:definition "simple statement on the smallest unit of division on the scale of measurement. An implementation may use the types described in ISO 19103: Conceptual Schema."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "precisionStatement" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:preferredBy a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/citationResponsibleParty> ;
    skos:definition "specifies that the name is the preferred name according to the named entity. The CI_Responsibility type may be used to further structure the information about the responsible party and their role."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "preferredBy" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:realizedNexus a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_HydroNexus ;
    skos:definition "identifies the one and only one nexus that is realized by a particular feature. Referencing the hydrologic complex containing the hydro nexus and all of its realizations, supports an arbitrary feature of interest to be recognized as outlet of a catchment, and to be placed using the river referencing defined in this standard."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "realizedNexus" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:receivingCatchment a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_Catchment ;
    skos:definition "identifies the catchment that receives flow from this hydro nexus. This allows connection of a catchment's inflow to an identified outflow and to determine its position through referencing the outflow."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "receivingCatchment" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:referenceLocation a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_HydroLocation ;
    skos:definition "identifies the permanent reference location, usually an existing inflow or outflow hydro nexus relative to which a position is assigned to a hydro location feature of interest."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "referenceLocation" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:referencedPosition a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_IndirectPosition ;
    skos:definition "position expressed as measured or otherwise described distance from a known, already located referent. Commonly, this is used to locate a feature of interest such as a hydrometric station in relation to a catchment's outlet fixed by co-ordinates."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "referencedPosition" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:usage a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_NameUsage ;
    skos:definition "expresses the kind of name usage in a specific community, using a term from the HY_NameUsage code list, or a controlled vocabulary. Alternative code lists may be used but should be related to the terms in the HY_NameUsage codelist using an appropriate formalism."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "usage" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:variantSpelling a owl:DatatypeProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates whether the name is a variant spelling or not using the Boolean value type."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "variantSpelling" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_Depression a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_Depression" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Depression?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Depression?_profile=alt> ;
    skos:definition """The HY_Depression feature type specializes the general HY_HydroFeature class. It describes land lower than the surrounding land as a container for standing water. A depression is part of the network of channels and depressions forming the connecting system in which waterbodies are contained as parts of hydrographic network.

Through generalization, HY_Depression inherits the name property. It has associations for the surfaceNetwork in which it participates, a body of standingWater and a stratum of a confinedWaterBody. An outlet-at-benchmark constraint emphasizes that a benchmark on the confined waterbody at the outlet of the catchment that is realized by the channel network."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_Depression" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_IndirectPosition a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_IndirectPosition" ;
    ns353:hasProperty hyf:distanceDescription,
        hyf:distanceExpression,
        hyf:linearElement,
        hyf:locatedReferent,
        hyf:referenceLocation ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_IndirectPosition?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_IndirectPosition?_profile=alt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/distanceDescription ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_DistanceDescription ;
            owl:onProperty hyf:distanceDescription ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/locatedReferent ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_HydroLocation ;
            owl:onProperty hyf:locatedReferent ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/linearElement ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_FlowPath ;
            owl:onProperty hyf:linearElement ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/referenceLocation ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_HydroLocation ;
            owl:onProperty hyf:referenceLocation ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/distanceExpression ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_DistanceFromReferent ;
            owl:onProperty hyf:distanceExpression ] ;
    skos:definition """The HY_IndirectPosition feature type defines the location referenced along an axis, without the necessity of a geometric realization. Indirect position uses a catchment-specific reference system which defines the flowpath as the required linear element along which the position is determined. The indirect position is then expressed as the distance from the upstream and/or downstream end of the flowpath, or from a referent that is already located on that flowpath.

The (indirect) position of an outflow node referenced along an upstream oriented flowpath can be expressed as the distance from an upstream inflow node located on that flowpath, while the (indirect) position of an inflow node referenced along a downstream oriented flowpath can be expressed as distance from a downstream outflow node located on the flowpath. An ‘intermediate’ position referencing known inflow and outflow nodes bounding a flowpath at both ends can be expressed as part of the distance along the entire flowpath, measured from the upstream end of an upstream flowpath, and/or from the downstream end of a downstream flowpath. A position referencing an already referenced location on the flowpath can be expressed as part of the distance along the entire flowpath, measured from the ‘located referent’.

HY_IndirectPosition carries the distanceExpression, and distanceDescription attributes, and has linearElement, locatedReferent and a referenceLocation associations. A point-referent constraint emphasizes the topological relationship between the linear element and point representation of the reference location; a measure-along-flowpath constraint defines the flowpath as the linear element to be used whenever a position is expressed as a distance from a referent."""@en,
        "The HY_IndirectPosition feature type defines the location referenced along an axis, without the necessity of a geometric realization. Indirect position uses a catchment-specific reference system which defines the flowpath as the required linear element along which the position is determined. The indirect position is then expressed as the distance from the upstream and/or downstream end of the flowpath, or from a referent that is already located on that flowpath.  The (indirect) position of an outflow node referenced along an upstream oriented flowpath can be expressed as the distance from an upstream inflow node located on that flowpath, while the (indirect) position of an inflow node referenced along a downstream oriented flowpath can be expressed as distance from a downstream outflow node located on the flowpath. An ‘intermediate’ position referencing known inflow and outflow nodes bounding a flowpath at both ends can be expressed as part of the distance along the entire flowpath, measured from the upstream end of an upstream flowpath, and/or from the downstream end of a downstream flowpath. A position referencing an already referenced location on the flowpath can be expressed as part of the distance along the entire flowpath, measured from the ‘located referent’.   HY_IndirectPosition carries the distanceExpression, and distanceDescription attributes, and has linearElement, locatedReferent and a referenceLocation associations. A point-referent constraint emphasizes the topological relationship between the linear element and point representation of the reference location; a measure-along-flowpath constraint defines the flowpath as the linear element to be used whenever a position is expressed as a distance from a referent."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_IndirectPosition" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_CatchmentArea a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_CatchmentArea" ;
    ns353:hasProperty geo:hasGeometry,
        hyf:realizedCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_CatchmentArea?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_CatchmentArea?_profile=alt> ;
    rdfs:subClassOf hyf:HY_CatchmentRealization ;
    skos:broader hyf:HY_CatchmentRealization ;
    skos:broaderTransitive hyf:HY_CatchmentRealization ;
    skos:definition """The HY_CatchmentArea feature type realizes a catchment specifically as a catchment area connecting the inflow and outflow of the catchment it realizes.

HY_CatchmentArea specializes HY_CatchmentRealization with respect to an implied areal geometric representation. Topologically, the catchment area connecting the inflow and outflow of the catchment is a face bounded inwards by an inflow edge and outwards by an outflow edge. Hydrologically, catchment area refers to the area having a common outlet for its runoff.

Through generalization, HY_CatchmentArea inherits the shape and the realizedCatchment properties. The optional shape of the catchment may be implemented as a surface."""@en,
        "The HY_CatchmentArea feature type realizes a catchment specifically as a catchment area connecting the inflow and outflow of the catchment it realizes.  HY_CatchmentArea specializes HY_CatchmentRealization with respect to an implied areal geometric representation. Topologically, the catchment area connecting the inflow and outflow of the catchment is a face bounded inwards by an inflow edge and outwards by an outflow edge. Hydrologically, catchment area refers to the area having a common outlet for its runoff.  Through generalization, HY_CatchmentArea inherits the shape and the realizedCatchment properties. The optional shape of the catchment may be implemented as a surface."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_CatchmentArea" .

hyf:HY_CatchmentDivide a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_CatchmentDivide" ;
    ns353:hasProperty geo:hasGeometry,
        hyf:realizedCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_CatchmentDivide?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_CatchmentDivide?_profile=alt> ;
    rdfs:subClassOf hyf:HY_CatchmentRealization ;
    skos:broader hyf:HY_CatchmentRealization ;
    skos:broaderTransitive hyf:HY_CatchmentRealization ;
    skos:definition """The HY_CatchmentDivide feature type realizes a catchment specifically as catchment boundary connecting the inflow and outflow of the catchment it realizes, whereby inflow and outflow may overlay.

Implying a linear geometric representation, a catchment boundary is topologically understood as an edge bounded by inflow node and outflow nodes, and corresponding to left-bank and right-bank catchment faces inside of the boundary. Hydrologically, the boundary refers to the summit line separating adjacent catchments.

Through generalization, HY_CatchmentDivide inherits the shape and the realizedCatchment properties. The shape of the catchment divide may be implemented as a composition of succeeding curves or a polygon ring."""@en,
        "The HY_CatchmentDivide feature type realizes a catchment specifically as catchment boundary connecting the inflow and outflow of the catchment it realizes, whereby inflow and outflow may overlay. Implying a linear geometric representation, a catchment boundary is topologically understood as an edge bounded by inflow node and outflow nodes, and corresponding to left-bank and right-bank catchment faces inside of the boundary. Hydrologically, the boundary refers to the summit line separating adjacent catchments.  Through generalization, HY_CatchmentDivide inherits the shape and the realizedCatchment properties. The shape of the catchment divide may be implemented as a composition of succeeding curves or a polygon ring."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_CatchmentDivide" .

hyf:HY_DendriticCatchment a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_DendriticCatchment" ;
    ns353:hasProperty hyf:catchmentRealization,
        hyf:code,
        hyf:conjointCatchment,
        hyf:containedCatchment,
        hyf:containingCatchment,
        hyf:inflow,
        hyf:lowerCatchment,
        hyf:name,
        hyf:outflow,
        hyf:upperCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_DendriticCatchment?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_DendriticCatchment?_profile=alt> ;
    rdfs:subClassOf hyf:HY_Catchment ;
    skos:broader hyf:HY_Catchment ;
    skos:broaderTransitive hyf:HY_Catchment,
        hyf:HY_HydroFeature ;
    skos:definition """The HY_DendriticCatchment feature type (Figure 31) specializes the general HY_Catchment class as a catchment which is determined by a single common downstream catchment. It represents the catchment as the topological link between an inflow and an outflow. This allows catchments to be connected in a dendritic network by upstream-downstream relationships without knowing the complex hydrology between inflow and outflow. This concept requires a stable identifier purposefully assigned to the catchment and that catchments are delineated as a simple tree hierarchy.

HY_DendriticCatchment inherits from generalization the code, outflow, inflow, containingCatchment, containedCatchment, conjointCatchment, upperCatchment, lowerCatchment, and catchmentRealization properties, and has an encompassingCatchment association. The dendritic nature of this feature is enforced through single-outflow, single-receiving-catchment and single-lower-catchment constraints."""@en,
        "The HY_DendriticCatchment feature type (Figure 31) specializes the general HY_Catchment class as a catchment which is determined by a single common downstream catchment. It represents the catchment as the topological link between an inflow and an outflow. This allows catchments to be connected in a dendritic network by upstream-downstream relationships without knowing the complex hydrology between inflow and outflow. This concept requires a stable identifier purposefully assigned to the catchment and that catchments are delineated as a simple tree hierarchy.  HY_DendriticCatchment inherits from generalization the code, outflow, inflow, containingCatchment, containedCatchment, conjointCatchment, upperCatchment, lowerCatchment, and catchmentRealization properties, and has an encompassingCatchment association. The dendritic nature of this feature is enforced through single-outflow, single-receiving-catchment and single-lower-catchment constraints."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_DendriticCatchment" .

hyf:HY_HydroFeatureName a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_HydroFeatureName" ;
    ns353:hasProperty hyf:name_string,
        hyf:namesPart,
        hyf:preferredBy,
        hyf:usage,
        hyf:variantSpelling ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroFeatureName?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroFeatureName?_profile=alt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/name_string ( 0:* ) " ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hyf:name_string ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/preferredBy ( 0:* ) " ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/citationResponsibleParty> ;
            owl:onProperty hyf:preferredBy ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/namesPart ( 0:* ) " ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty hyf:namesPart ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/variantSpelling ( 0:* ) " ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty hyf:variantSpelling ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/usage ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_NameUsage ;
            owl:onProperty hyf:usage ] ;
    skos:definition "pattern to handle cultural, political and historical variability of names. This supports the assignment of a referenceable name for all or parts of a hydrologic feature without necessarily having a formal model for the naming."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_HydroFeatureName" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_InteriorCatchment a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_InteriorCatchment" ;
    ns353:hasProperty hyf:catchmentRealization,
        hyf:code,
        hyf:conjointCatchment,
        hyf:containedCatchment,
        hyf:containingCatchment,
        hyf:inflow,
        hyf:lowerCatchment,
        hyf:name,
        hyf:outflow,
        hyf:upperCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_InteriorCatchment?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_InteriorCatchment?_profile=alt> ;
    rdfs:subClassOf hyf:HY_Catchment ;
    skos:broader hyf:HY_Catchment ;
    skos:broaderTransitive hyf:HY_Catchment,
        hyf:HY_HydroFeature ;
    skos:definition "The HY_InteriorCatchment feature type (Figure 32) specializes the general HY_Catchment class as a catchment which is generally not connected to other catchments. This class describes the interior catchment as a catchment enveloped by other catchments to which it may temporarily contribute. While the interior catchment concept precludes flow to neighboring surface catchments, holistically it is a candidate for establishing connections to groundwater or atmospheric systems."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_InteriorCatchment" .

hyf:catchmentRealization a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_CatchmentRealization ;
    skos:definition "topological or geographic feature which realizes the logical catchment."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "catchmentRealization" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:code a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range rdfs:Resource ;
    skos:definition "unique identifier to the catchment in given context. The code attribute should be implemented using a controlled classification or coding system. Example: WMO Basin Codes."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "code" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:conjointCatchment a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_Catchment ;
    skos:definition "catchment that interacts with the catchment across an internal boundary line."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "conjointCatchment" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:containedCatchment a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_Catchment ;
    skos:definition "catchment nested in a containing catchment."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "containedCatchment" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:containingCatchment a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_Catchment ;
    skos:definition "catchment nesting contained catchments."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "containingCatchment" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:inflow a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_HydroNexus ;
    skos:definition "hydro nexus in terms of an inflow to the receiving catchment. For a dendritic network of catchments, the outflow of a contributing catchment coincides with the inflow to a receiving catchment. This supports description of upstream-downstream relationships between catchments."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "inflow" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:lowerCatchment a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_Catchment ;
    skos:definition "catchment located immediately below of the catchment,"@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "lowerCatchment" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:outflow a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_HydroNexus ;
    skos:definition "hydro nexus in terms of an outflow of the contributing catchment. For a dendritic network of catchments, the outflow of a contributing catchment coincides with the inflow to a receiving catchment. This supports description of upstream-downstream relationships between catchments."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "outflow" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:upperCatchment a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_Catchment ;
    skos:definition "catchment located immediately above of the catchment,"@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "upperCatchment" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_FlowPath a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_FlowPath" ;
    ns353:hasProperty geo:hasGeometry,
        hyf:realizedCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_FlowPath?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_FlowPath?_profile=alt> ;
    rdfs:subClassOf hyf:HY_CatchmentRealization ;
    skos:broader hyf:HY_CatchmentRealization ;
    skos:broaderTransitive hyf:HY_CatchmentRealization ;
    skos:definition """The HY_Flowpath feature type realizes a catchment specifically as a path connecting the inflow and outflow of the catchment it realizes.

HY_Flowpath specializes HY_CatchmentRealization with respect to an implied linear geometric representation including a straight or curved line. Topologically, the flowpath connects the inflow and outflow of the catchment, and is understood as an edge bounded by an inflow node and an outflow node, and corresponding to left-bank and right-bank catchment faces. Hydrologically, the flowpath is a line describing a moving particle of water.

Through generalization, HY_Flowpath inherits the shape and the realizedCatchment properties. The optional shape of the flowpath is usually a single curve."""@en,
        "The HY_Flowpath feature type realizes a catchment specifically as a path connecting the inflow and outflow of the catchment it realizes. HY_Flowpath specializes HY_CatchmentRealization with respect to an implied linear geometric representation including a straight or curved line. Topologically, the flowpath connects the inflow and outflow of the catchment, and is understood as an edge bounded by an inflow node and an outflow node, and corresponding to left-bank and right-bank catchment faces. Hydrologically, the flowpath is a line describing a moving particle of water.  Through generalization, HY_Flowpath inherits the shape and the realizedCatchment properties. The optional shape of the flowpath is usually a single curve."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_FlowPath" .

hyf:name a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:domain hyf:HY_HydroFeature ;
    rdfs:range hyf:HY_HydroFeatureName ;
    skos:definition "name given to the hydrologic feature in cultural, political or historical context."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "name" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_HydroLocation a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "ReferenceLocation"@en ;
    ns353:hasProperty geo:hasGeometry,
        hyf:hydroLocationType,
        hyf:realizedNexus,
        hyf:referencedPosition ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroLocation?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroLocation?_profile=alt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/realizedNexus ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_HydroNexus ;
            owl:onProperty hyf:realizedNexus ],
        [ a owl:Restriction ;
            rdfs:label "http://www.opengis.net/ont/geosparql#hasGeometry ( 0:* ) " ;
            owl:allValuesFrom geo:Geometry ;
            owl:onProperty geo:hasGeometry ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/hydroLocationType ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_HydroLocationType ;
            owl:onProperty hyf:hydroLocationType ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/referencedPosition ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_IndirectPosition ;
            owl:onProperty hyf:referencedPosition ] ;
    skos:definition """The HY_HydroLocation feature type (Figure 35) conceptualizes the idea that a hydro nexus can be realized by practically any feature of interest. The hydro nexus concept is used to define the hydrologic determination of a catchment but, like the catchment concept, does not have inherent realization(s). Any hydrologically significant feature that can be identified as (said to be) the outlet of a catchment may realize the hydro nexus. Typically, this will be a permanent, stable location that is fixed and/or referenced by coordinates.

Landmarks such as confluences, points corresponding to vertical sections, or the position of a monitoring station on a river are typical realizations of the hydro nexus. Other kinds of hydro nexus realizations that don't carry normal surface water characteristics as defined in this standard, e.g. a spring where groundwater enters the surface, an arbitrary point projected onto the surface, or a nexus that collects many disjoint locations may use or specialize the general HY_HydroLocation type.

Topologically, the HY_HydroLocation should be understood to be the boundary of the corresponding catchment, and always of lower topological dimension than the catchment. Even though the topological realization of a hydro nexus is typically as a node between catchment edges, a nexus realization may also have any geometric representation, including a single point.

In many cases, HY_HydroLocations are known but corresponding catchments and hydro nexuses are not defined. For example, stream gages that are part of a catchment dataset whose hydro nexus features are realized by confluences. Both the stream gages and confluences are HY_HydroLocations, but the stream gages’ hydro nexus features are not defined. Using this concept, HY_HydroLocation is expected to be used to link between datasets that have catchments delineated for different HY_HydroLocations.

HY_HydroLocation carries two attributes: shape and hydroLocationType. It has referencedPosition and realizedNexus associations implying the hydro-complex feature collection."""@en,
        "The HY_HydroLocation feature type (Figure 35) conceptualizes the idea that a hydro nexus can be realized by practically any feature of interest. The hydro nexus concept is used to define the hydrologic determination of a catchment but, like the catchment concept, does not have inherent realization(s). Any hydrologically significant feature that can be identified as (said to be) the outlet of a catchment may realize the hydro nexus. Typically, this will be a permanent, stable location that is fixed and/or referenced by coordinates.  Landmarks such as confluences, points corresponding to vertical sections, or the position of a monitoring station on a river are typical realizations of the hydro nexus. Other kinds of hydro nexus realizations that don't carry normal surface water characteristics as defined in this standard, e.g. a spring where groundwater enters the surface, an arbitrary point projected onto the surface, or a nexus that collects many disjoint locations may use or specialize the general HY_HydroLocation type.  Topologically, the HY_HydroLocation should be understood to be the boundary of the corresponding catchment, and always of lower topological dimension than the catchment. Even though the topological realization of a hydro nexus is typically as a node between catchment edges, a nexus realization may also have any geometric representation, including a single point. In many cases, HY_HydroLocations are known but corresponding catchments and hydro nexuses are not defined. For example, stream gages that are part of a catchment dataset whose hydro nexus features are realized by confluences. Both the stream gages and confluences are HY_HydroLocations, but the stream gages’ hydro nexus features are not defined. Using this concept, HY_HydroLocation is expected to be used to link between datasets that have catchments delineated for different HY_HydroLocations. HY_HydroLocation carries two attributes: shape and hydroLocationType. It has referencedPosition and realizedNexus associations implying the hydro-complex feature collection."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "ReferenceLocation"@en ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_HydroNexus a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_HydroNexus" ;
    ns353:hasProperty hyf:contributingCatchment,
        hyf:nexusRealization,
        hyf:receivingCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroNexus?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroNexus?_profile=alt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/contributingCatchment ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_Catchment ;
            owl:onProperty hyf:contributingCatchment ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/receivingCatchment ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_Catchment ;
            owl:onProperty hyf:receivingCatchment ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/nexusRealization ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_HydroLocation ;
            owl:onProperty hyf:nexusRealization ] ;
    skos:definition """The HY_HydroNexus feature type (Figure 33) conceptualizes a hydrologically determined nexus of a corresponding catchment (Figure 26). The hydro nexus represents the place where a catchment interacts with another catchment, i.e. where the outflow of a contributing catchment becomes inflow into a receiving catchment. A catchment may receive flow from several upstream catchments or contribute flow to several downstream catchments through a single hydro nexus. Through shared identity, each hydro nexus feature may be associated with different realizations within a hydrologic complex given that each realization has the same hydrologic function or characteristics. This includes the topological realization as a node on the one-dimensional flowpath (edge) in terms of a topological 'boundary'.

Placed topologically relative to a catchment which links inflow and outflow, a hydro nexus has a position relative to another hydro nexus that is 'fixed' in the network by the catchments it is associated with. Additionally, the union of catchment and hydro nexus(es) can be used to define a linear river reference system, where an inflow or outflow node is the origin and the flowpath realizing the catchment is the linear element along which a position can be determined."""@en,
        "The HY_HydroNexus feature type (Figure 33) conceptualizes a hydrologically determined nexus of a corresponding catchment (Figure 26). The hydro nexus represents the place where a catchment interacts with another catchment, i.e. where the outflow of a contributing catchment becomes inflow into a receiving catchment. A catchment may receive flow from several upstream catchments or contribute flow to several downstream catchments through a single hydro nexus. Through shared identity, each hydro nexus feature may be associated with different realizations within a hydrologic complex given that each realization has the same hydrologic function or characteristics. This includes the topological realization as a node on the one-dimensional flowpath (edge) in terms of a topological 'boundary'.  Placed topologically relative to a catchment which links inflow and outflow, a hydro nexus has a position relative to another hydro nexus that is 'fixed' in the network by the catchments it is associated with. Additionally, the union of catchment and hydro nexus(es) can be used to define a linear river reference system, where an inflow or outflow node is the origin and the flowpath realizing the catchment is the linear element along which a position can be determined."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_HydroNexus" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:realizedCatchment a owl:ObjectProperty,
        skos:Concept ;
    ns10:status ns11:valid ;
    rdfs:range hyf:HY_Catchment ;
    skos:definition "identifies the one and only one catchment that is realized by a particular feature. Referencing the hydrologic complex containing the catchment and all of its realizations, supports a catchment's existence to be recognized and linked to multiple realizations without the complexity and full detail of a scientific model. By referencing the catchment topology, topological relationships can be established and common identifiers assigned."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "realizedCatchment" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_HydroFeature a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_HydroFeature" ;
    ns353:hasProperty hyf:name ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroFeature?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_HydroFeature?_profile=alt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/name ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_HydroFeatureName ;
            owl:onProperty hyf:name ] ;
    skos:definition "basic feature to reflect the properties that all hydrologic features have."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:narrower hyf:HY_Catchment ;
    skos:prefLabel "HY_HydroFeature" ;
    skos:topConceptOf hyfeatures:hyf ;
    foaf:depiction <https://defs-dev.opengis.net/ogc-na/definitions/schema/hy_features/hyf/class_diagram.png> .

hyf:HY_WaterBody a ns7:FeatureType,
        skos:Concept ;
    rdfs:label "HY_WaterBody" ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_WaterBody?_profile=conceptscheme> ;
    ns10:status ns11:experimental ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_WaterBody?_profile=alt> ;
    skos:definition """The HY_WaterBody feature type specializes the general HY_HydroFeature class. A waterbody is part of the hydrographic network and is either standing in a depression or flowing in a channel, which are parts of the channel network. A waterbody may be segmented in vertical sections at right angles to the main (average) direction of flow or along its centerline, and horizontal strata. Conceptually, each waterbody, or a stratum, could be thought of as a reservoir used for storage, regulation or control of water recourses.

Through generalization, HY_WaterBody inherits the name property. It has associations for the hydrographicNetwork in which it participates, the containing waterpool and watercourse, the vertical streamCrossSection, streamLongitudinalSection, a horizontal stratum, and a reservoir for storage of water. Outlet-at-section and outlet-at-landmark constraints emphasize the recognition of a fixed landmark as outlet of the catchment realized by hydrographic network."""@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:prefLabel "HY_WaterBody" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_CatchmentRealization a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_CatchmentRealization" ;
    ns353:hasProperty geo:hasGeometry,
        hyf:realizedCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_CatchmentRealization?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:comment "Entailed as SKOS Concept for Linked Data purposes." ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_CatchmentRealization?_profile=alt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/realizedCatchment ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_Catchment ;
            owl:onProperty hyf:realizedCatchment ],
        [ a owl:Restriction ;
            rdfs:label "http://www.opengis.net/ont/geosparql#hasGeometry ( 0:* ) " ;
            owl:allValuesFrom geo:Geometry ;
            owl:onProperty geo:hasGeometry ] ;
    skos:definition """The HY_CatchmentRealization feature type (Figure 34) is based on the idea that there are multiple hydrology-specific perspectives of the holistic catchment concept that are used to describe a catchment as a unit of study shared across sub-domains and studies.

A given catchment realization exists within a hydrologic complex in that, if a catchment realization exists, it exists in the same hydrologic complex as the catchment it realizes. In this way, any realization of a catchment has the same hydrologic determination of the catchment it realizes. If a catchment is connected with other catchments via inflow and/or outflow hydro nexuses, its realizations are also connected. A realization of the logical catchment is always of higher topological dimension than the realization of the corresponding hydro nexus topological boundary. For example, a linear flowpath realizing a catchment may be understood as an edge between inflow and outflow nodes; the areal realization of a catchment as a face bounded by linear inflow and outflow.

The catchment realization features defined in this standard refer to objects on the land surface for the purpose of surface water hydrology. In other contexts, other types of catchment realization may exist. Catchment realizations that do not conform to those defined in this standard, for instance realizations in 3- or 4-dimensional perspectives, may be implemented using the general HY_CatchmentRealization type. HY_CatchmentRealization carries a shape attribute and as a realizedCatchment association."""@en,
        "The HY_CatchmentRealization feature type (Figure 34) is based on the idea that there are multiple hydrology-specific perspectives of the holistic catchment concept that are used to describe a catchment as a unit of study shared across sub-domains and studies.  A given catchment realization exists within a hydrologic complex in that, if a catchment realization exists, it exists in the same hydrologic complex as the catchment it realizes. In this way, any realization of a catchment has the same hydrologic determination of the catchment it realizes. If a catchment is connected with other catchments via inflow and/or outflow hydro nexuses, its realizations are also connected. A realization of the logical catchment is always of higher topological dimension than the realization of the corresponding hydro nexus topological boundary. For example, a linear flowpath realizing a catchment may be understood as an edge between inflow and outflow nodes; the areal realization of a catchment as a face bounded by linear inflow and outflow. The catchment realization features defined in this standard refer to objects on the land surface for the purpose of surface water hydrology. In other contexts, other types of catchment realization may exist. Catchment realizations that do not conform to those defined in this standard, for instance realizations in 3- or 4-dimensional perspectives, may be implemented using the general HY_CatchmentRealization type. HY_CatchmentRealization carries a shape attribute and as a realizedCatchment association."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:narrower hyf:HY_CartographicRealization,
        hyf:HY_CatchmentArea,
        hyf:HY_CatchmentDivide,
        hyf:HY_FlowPath,
        hyf:HY_HydroNetwork ;
    skos:prefLabel "HY_CatchmentRealization" ;
    skos:topConceptOf hyfeatures:hyf .

hyf:HY_Catchment a ns7:FeatureType,
        owl:Class,
        skos:Concept ;
    rdfs:label "HY_Catchment" ;
    ns353:hasProperty hyf:catchmentRealization,
        hyf:code,
        hyf:conjointCatchment,
        hyf:containedCatchment,
        hyf:containingCatchment,
        hyf:inflow,
        hyf:lowerCatchment,
        hyf:name,
        hyf:outflow,
        hyf:upperCatchment ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf/HY_Catchment?_profile=conceptscheme> ;
    ns10:status ns11:experimental,
        ns11:valid ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf/HY_Catchment?_profile=alt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/inflow ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_HydroNexus ;
            owl:onProperty hyf:inflow ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/catchmentRealization ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_CatchmentRealization ;
            owl:onProperty hyf:catchmentRealization ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/conjointCatchment ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_Catchment ;
            owl:onProperty hyf:conjointCatchment ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/containingCatchment ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_Catchment ;
            owl:onProperty hyf:containingCatchment ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/code ( 0:* ) " ;
            owl:allValuesFrom rdfs:Resource ;
            owl:onProperty hyf:code ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/upperCatchment ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_Catchment ;
            owl:onProperty hyf:upperCatchment ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/outflow ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_HydroNexus ;
            owl:onProperty hyf:outflow ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/containedCatchment ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_Catchment ;
            owl:onProperty hyf:containedCatchment ],
        [ a owl:Restriction ;
            rdfs:label "https://www.opengis.net/def/schema/hy_features/hyf/lowerCatchment ( 0:* ) " ;
            owl:allValuesFrom hyf:HY_Catchment ;
            owl:onProperty hyf:lowerCatchment ],
        hyf:HY_HydroFeature ;
    skos:broader hyf:HY_HydroFeature ;
    skos:broaderTransitive hyf:HY_HydroFeature ;
    skos:definition """The Catchment model conceptualizes the hydrologic determination of a catchment through inflow and outflow hydro nexus features with the role of getting flow from a contributing catchment, or providing inflow to a receiving catchment (Figure 25 and Figure 26). Conceptually, each catchment has an outflow hydro nexus, and any hydro nexus has a corresponding catchment, even if catchment and/or hydro nexus may not be present in a particular application. A catchment interacts with upper and lower catchments via associated hydro nexuses, and ultimately contributes flow to the hydro nexus of a containing catchment. The catchment should be understood as the logical link between two hydro nexuses.

The HY_Catchment feature type captures the union of catchment and hydro nexus, and the multiple realizations of the holistic catchment concept. These realizations include both topological realizations, as well as their geometric representation. HY_Catchment may be further specialized with respect to catchment interaction.

The HY_Catchment feature type (Figure 26) specializes the general HY_HydroFeature type. Through generalization, HY_Catchment inherits the name property. It carries a code attribute and the associations: outflow, inflow, containingCatchment, containedCatchment, conjointCatchment, upperCatchment, lowerCatchment, catchmentRealization."""@en,
        "The Catchment model conceptualizes the hydrologic determination of a catchment through inflow and outflow hydro nexus features with the role of getting flow from a contributing catchment, or providing inflow to a receiving catchment (Figure 25 and Figure 26). Conceptually, each catchment has an outflow hydro nexus, and any hydro nexus has a corresponding catchment, even if catchment and/or hydro nexus may not be present in a particular application. A catchment interacts with upper and lower catchments via associated hydro nexuses, and ultimately contributes flow to the hydro nexus of a containing catchment. The catchment should be understood as the logical link between two hydro nexuses. The HY_Catchment feature type captures the union of catchment and hydro nexus, and the multiple realizations of the holistic catchment concept. These realizations include both topological realizations, as well as their geometric representation. HY_Catchment may be further specialized with respect to catchment interaction.  The HY_Catchment feature type (Figure 26) specializes the general HY_HydroFeature type. Through generalization, HY_Catchment inherits the name property. It carries a code attribute and the associations: outflow, inflow, containingCatchment, containedCatchment, conjointCatchment, upperCatchment, lowerCatchment, catchmentRealization."@en ;
    skos:inScheme hyfeatures:hyf ;
    skos:narrower hyf:HY_CatchmentAggregate,
        hyf:HY_DendriticCatchment,
        hyf:HY_InteriorCatchment ;
    skos:prefLabel "HY_Catchment" .

hyfeatures:hyf a owl:Ontology,
        skos:ConceptScheme ;
    rdfs:label "HY_Features HydroFeature package",
        "https://www.opengis.net/def/schema/hy_features/hyf" ;
    dcterms:source bodies:ogcna ;
    dcterms:title "https://www.opengis.net/def/schema/hy_features/hyf" ;
    ns353:codelistList <https://www.opengis.net/def/schema/hy_features/hyf/CodeLists/> ;
    ns353:ftList <https://www.opengis.net/def/schema/hy_features/hyf/FeatureTypes/> ;
    ns353:propertyList <https://www.opengis.net/def/schema/hy_features/hyf/Properties/> ;
    ns7:hasProfile <https://www.opengis.net/def/schema/hy_features/hyf?_profile=conceptscheme> ;
    ns10:collectionView hyf: ;
    ns10:status ns11:experimental ;
    ns7:sourceGraph hyfeatures:hyf ;
    rdfs:comment "This object provides the metadata view of an application schema. Definitions are organised as a SKOS ConceptScheme and can be accessed via the collection view property."@en ;
    rdfs:seeAlso <https://www.opengis.net/def/schema/hy_features/hyf?_profile=alt> ;
    owl:imports <http://eelst.cs.unibo.it/apps/LODE/source?url=http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata.ttl>,
        <http://shapechange.net/resources/ont/base>,
        ns349:geosparql ;
    skos:definition """The HydroFeature module (Figure 21) provides the core concepts of a named hydrologic feature in the Named Feature, of a hydrologic complex in which the union of catchment and its common outlet is realized in several ways by a collection of hydrologic features, and of a river referencing system which allows placement of an arbitrary feature ‘along a river’ using linear referencing along a one-dimensional topological, flowpath realization.  The HY_HydroFeature feature type is defined as hydrology-specific instance of the General Feature metaclass (as defined in the OGC General Feature Model, GFM), whose identity needs to be maintained and tracked through a processing chain from measurement to distribution of hydrologic information.
As an instance of the General Feature metaclass a feature type is identified by a unique identifier and typical properties. Typically, a hydrologic feature is additionally identified through names in common usage and through hydrologically significant characteristics.  The HY_HydroFeature feature type is specialized into more specific feature types (Figure 23), which specify additional properties and represent particular hydrologic phenomena.Providing a standard terminology for the typical relationships between hydrologic features allows the hydrosphere to be expressed in a consistent way across multiple data products, regardless of various spatial or temporal representations. The definitions of HydroFeature feature types are rooted in the definitions documented in the WMO/UNESCO Glossary of Hydrology. They are applied regardless of their application context in respect to the Earth's surface. For the purpose of testing the applicability of the HY_Features conceptual model in the context of surface water hydrology, the definitions in this standard refer to surface water hydrology. A conceptual model capturing the specifics of features associated with the groundwater domain is developed with reference to the OGC WaterML 2: Part 4 – GroundwaterML2 standard."""@en ;
    skos:prefLabel "HY_Features HydroFeature package" ;
    skos:topConcept hyf:HY_Canal,
        hyf:HY_CartographicRealization,
        hyf:HY_Catchment,
        hyf:HY_CatchmentAggregate,
        hyf:HY_CatchmentArea,
        hyf:HY_CatchmentDivide,
        hyf:HY_CatchmentRealization,
        hyf:HY_Channel,
        hyf:HY_ChannelNetwork,
        hyf:HY_CrossSection,
        hyf:HY_DendriticCatchment,
        hyf:HY_Depression,
        hyf:HY_Estuary,
        hyf:HY_FlowPath,
        hyf:HY_HydroFeature,
        hyf:HY_HydroFeatureName,
        hyf:HY_HydroLocation,
        hyf:HY_HydroNetwork,
        hyf:HY_HydroNexus,
        hyf:HY_HydrographicNetwork,
        hyf:HY_HydrometricFeature,
        hyf:HY_HydrometricNetwork,
        hyf:HY_Impoundment,
        hyf:HY_IndirectPosition,
        hyf:HY_InteriorCatchment,
        hyf:HY_Lagoon,
        hyf:HY_Lake,
        hyf:HY_LongitudinalSection,
        hyf:HY_Reservoir,
        hyf:HY_River,
        hyf:HY_WaterBody,
        hyf:HY_WaterBodyStratum,
        hyf:HY_Water_LiquidPhase,
        hyf:HY_Water_SolidPhase ;
    foaf:depiction <https://www.opengis.net/def/schema/hy_features/hyf?_profile=class_diagram&_mediatype=image/png> .

