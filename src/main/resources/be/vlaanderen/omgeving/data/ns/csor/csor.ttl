csor:verplicht
    a owl:DatatypeProperty, rdf:Property ;
    rdfs:label "verplicht"@nl ;
    rdfs:comment "Duidt aan of deze term verplicht is in een veelterm-afleiding (niet elke term hoeft aanwezig te zijn om de optelling te mogen maken)."@nl ;
