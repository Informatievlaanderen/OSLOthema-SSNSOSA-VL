@prefix ex: <http://example.org/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .

<http://example.org/mijn-ontologie> a owl:Ontology .

sosa:isProxyFor a owl:ObjectProperty .
sosa:Property   a owl:Class .
ex:Sensor       a owl:Class ;
    owl:disjointWith sosa:Property .

ssn:Stimulus a owl:Class ;
    rdfs:subClassOf [
                        a owl:Restriction ;
                        owl:onProperty    sosa:isProxyFor ;
                        owl:allValuesFrom sosa:Property
                    ] .
ex:stimulus a ssn:Stimulus ;
    sosa:isProxyFor ex:sensor .

ex:sensor a ex:Sensor .