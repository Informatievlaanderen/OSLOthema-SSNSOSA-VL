csor-parameteraspect:PAS_200 a sosa:Property,
        csor:ParameterAspect ;
    rdfs:label "Iopromide (standaard in water): massaconcentratie"@nl .

matrix:afvalwater a skos:Concept ;
    rdfs:label "Afvalwater"@nl .

ex:collectie-vrachtbronnen-bedrijven-rio-2014 a sosa:ExecutionCollection,
        sosa:ObservationCollection,
        wk:WaterkwaliteitObservatieVerzameling ;
    rdfs:label "Concentraties en debiet 2014, lozingen van bedrijven (Riool)"@nl ;
    sosa:hasFeatureOfInterest ex:lozingsgroep-bedrijven-rio ;
    sosa:hasMember ex:observatie-concentratie-bedrijven-rio-2014-P_117,
        ex:observatie-concentratie-bedrijven-rio-2014-P_125,
        ex:observatie-concentratie-bedrijven-rio-2014-P_126,
        ex:observatie-debiet-bedrijven-rio-2014 ;
    sosa:phenomenonTime ex:periode-2014 .

ex:resultaat-brutovracht-bedrijven-rio-2014-P_117 a sosa:Result,
        wk:Meetresultaat ;
    qudt:hasUnit csor-eenheid:E_37 ;
    qudt:numericValue 276107193.252673 ;
    sosa:isResultOf ex:observatie-brutovracht-bedrijven-rio-2014-P_117 .

ex:resultaat-brutovracht-bedrijven-rio-2014-P_125 a sosa:Result,
