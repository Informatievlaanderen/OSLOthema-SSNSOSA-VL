ex:periode-2014 a time:Interval ;
    time:hasBeginning ex:tijdstip-2014-01-01T000000 ;
    time:hasEnd ex:tijdstip-2015-01-01T000000 .

ex:lozingsgroep-bedrijven-rio a prov:Entity,
        sosa:FeatureOfInterest,
        wk:Emissie ;
    rdfs:label "Lozingen van bedrijven — type meetput riool"@nl ;
    dct:identifier "Bedrijven/RIO" ;
    dct:type matrix:afvalwater ;
    sosa:isFeatureOfInterestOf ex:collectie-vrachtbronnen-bedrijven-rio-2014,
        ex:observatie-brutovracht-bedrijven-rio-2014-P_117,
        ex:observatie-brutovracht-bedrijven-rio-2014-P_125,
        ex:observatie-brutovracht-bedrijven-rio-2014-P_126,
        ex:observatie-concentratie-bedrijven-rio-2014-P_117,
        ex:observatie-concentratie-bedrijven-rio-2014-P_125,
        ex:observatie-concentratie-bedrijven-rio-2014-P_126,
        ex:observatie-debiet-bedrijven-rio-2014,
        ex:observatie-nettovracht-bedrijven-rio-2014-P_117,
        ex:observatie-nettovracht-bedrijven-rio-2014-P_125,
