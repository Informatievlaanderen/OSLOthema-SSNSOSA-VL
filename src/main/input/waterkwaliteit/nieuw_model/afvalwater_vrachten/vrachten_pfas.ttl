# Jaarvrachten PFAS (VMM, 240426) als SSN/SOSA 2023 -- DIT IS VOORBEELDDATA
# Gegenereerd door scripts/afvalwater_vrachten.py; niet manueel bewerken.
# Validatie-subset: meetput 2030042.
@prefix csor: <https://data.omgeving.vlaanderen.be/ns/csor#> .
@prefix csor-eenheid: <https://data.omgeving.vlaanderen.be/id/concept/csor/eenheid/> .
@prefix csor-kwa: <https://data.omgeving.vlaanderen.be/id/concept/csor/kwantificeerbaaraspect/> .
@prefix csor-parameteraspect: <https://data.omgeving.vlaanderen.be/id/concept/csor/parameteraspect/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/waterkwaliteit/afvalwater/> .
@prefix matrix: <https://data.omgeving.vlaanderen.be/id/concept/matrix/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix wk: <https://data.vlaanderen.be/ns/waterkwaliteit#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

csor-eenheid:E_32 a csor:Eenheid ;
    rdfs:label "kubieke meter"@nl .

csor-eenheid:E_4 a csor:Eenheid ;
    rdfs:label "microgram per liter"@nl .

csor-parameteraspect:PAS_1839 a sosa:Property,
        csor:ParameterAspect ;
    rdfs:label "Q (standaard in water): debiet (vracht)"@nl .

csor-parameteraspect:PAS_2520 a sosa:Property,
        csor:ParameterAspect ;
    rdfs:label "PFOS (standaard in water): massaconcentratie"@nl .

ex:procedure-netto-vracht a sosa:ObservingProcedure,
        sosa:Procedure ;
    rdfs:label "Berekening netto vracht"@nl ;
    rdfs:comment "Berekeningswijze niet in de bron; in 251013 gelijk aan de bruto vracht (bestand 'geenInEx'). Te bevestigen door de VMM (stappenplan.md V10)."@nl ;
    sosa:hasOutput csor-kwa:KWA_5 .

csor-kwa:KWA_1 a skos:Concept,
        csor:KwantificeerbaarAspect ;
    rdfs:label "massaconcentratie"@nl .

csor-kwa:KWA_10 a skos:Concept,
        csor:KwantificeerbaarAspect ;
    rdfs:label "debiet (vracht)"@nl .

csor-parameteraspect:PAS_2521 a sosa:Property,
        csor:ParameterAspect ;
    rdfs:label "PFOS (standaard in water): vracht"@nl .

csor-parameteraspect:PAS_2525 a sosa:Property,
        csor:ParameterAspect ;
    rdfs:label "PFHpA (standaard in water): vracht"@nl .

csor-parameteraspect:PAS_2529 a sosa:Property,
        csor:ParameterAspect ;
    rdfs:label "PFOA (standaard in water): vracht"@nl .

matrix:afvalwater a skos:Concept ;
    rdfs:label "Afvalwater"@nl .

ex:periode-2009 a time:Interval ;
    time:hasBeginning ex:tijdstip-2009-01-01T000000 ;
    time:hasEnd ex:tijdstip-2010-01-01T000000 .

ex:periode-2017 a time:Interval ;
    time:hasBeginning ex:tijdstip-2017-01-01T000000 ;
    time:hasEnd ex:tijdstip-2018-01-01T000000 .

ex:periode-2022 a time:Interval ;
    time:hasBeginning ex:tijdstip-2022-01-01T000000 ;
    time:hasEnd ex:tijdstip-2023-01-01T000000 .

ex:resultaat-brutovracht-2030042-2009-PAS_2521 a sosa:Result,
        wk:Meetresultaat ;
    qudt:hasUnit csor-eenheid:E_37 ;
    qudt:numericValue 2799.02 ;
    sosa:isResultOf ex:observatie-brutovracht-2030042-2009-PAS_2521 .

ex:resultaat-brutovracht-2030042-2017-PAS_2529 a sosa:Result,
        wk:Meetresultaat ;
    qudt:hasUnit csor-eenheid:E_37 ;
    qudt:numericValue 364.385283 ;
    sosa:isResultOf ex:observatie-brutovracht-2030042-2017-PAS_2529 .

ex:resultaat-brutovracht-2030042-2022-PAS_2525 a sosa:Result,
        wk:Meetresultaat ;
    qudt:hasUnit csor-eenheid:E_37 ;
    qudt:numericValue 0.0 ;
    sosa:isResultOf ex:observatie-brutovracht-2030042-2022-PAS_2525 .

ex:tijdstip-2009-01-01T000000 a time:Instant ;
    time:inXSDDateTime "2009-01-01T00:00:00"^^xsd:dateTime .

ex:tijdstip-2010-01-01T000000 a time:Instant ;
    time:inXSDDateTime "2010-01-01T00:00:00"^^xsd:dateTime .

ex:tijdstip-2017-01-01T000000 a time:Instant ;
    time:inXSDDateTime "2017-01-01T00:00:00"^^xsd:dateTime .

ex:tijdstip-2018-01-01T000000 a time:Instant ;
    time:inXSDDateTime "2018-01-01T00:00:00"^^xsd:dateTime .

ex:tijdstip-2022-01-01T000000 a time:Instant ;
    time:inXSDDateTime "2022-01-01T00:00:00"^^xsd:dateTime .

ex:tijdstip-2023-01-01T000000 a time:Instant ;
    time:inXSDDateTime "2023-01-01T00:00:00"^^xsd:dateTime .

csor-kwa:KWA_5 a skos:Concept,
        csor:KwantificeerbaarAspect ;
    rdfs:label "vracht"@nl .

ex:observatie-brutovracht-2030042-2009-PAS_2521 a sosa:Execution,
        sosa:Observation,
        wk:WaterkwaliteitObservatie ;
    rdfs:label "Bruto jaarvracht PFOS 2009, meetput AW2030042 (ANTWERP WASTE MANAGEMENT)"@nl ;
    sosa:hasFeatureOfInterest ex:lozing-2030042 ;
    sosa:hasResult ex:resultaat-brutovracht-2030042-2009-PAS_2521 ;
    sosa:observedProperty csor-parameteraspect:PAS_2521 ;
    sosa:phenomenonTime ex:periode-2009 ;
    sosa:usedProcedure ex:procedure-bruto-vracht .

ex:observatie-brutovracht-2030042-2017-PAS_2529 a sosa:Execution,
        sosa:Observation,
        wk:WaterkwaliteitObservatie ;
    rdfs:label "Bruto jaarvracht PFOA 2017, meetput AW2030042 (VEOLIA ES MRC)"@nl ;
    sosa:hasFeatureOfInterest ex:lozing-2030042 ;
    sosa:hasResult ex:resultaat-brutovracht-2030042-2017-PAS_2529 ;
    sosa:observedProperty csor-parameteraspect:PAS_2529 ;
    sosa:phenomenonTime ex:periode-2017 ;
    sosa:usedProcedure ex:procedure-bruto-vracht .

ex:observatie-brutovracht-2030042-2022-PAS_2525 a sosa:Execution,
        sosa:Observation,
        wk:WaterkwaliteitObservatie ;
    rdfs:label "Bruto jaarvracht PFHpA 2022, meetput AW2030042 (VEOLIA ES MRC)"@nl ;
    sosa:hasFeatureOfInterest ex:lozing-2030042 ;
    sosa:hasResult ex:resultaat-brutovracht-2030042-2022-PAS_2525 ;
    sosa:observedProperty csor-parameteraspect:PAS_2525 ;
    sosa:phenomenonTime ex:periode-2022 ;
    sosa:usedProcedure ex:procedure-bruto-vracht .

csor-eenheid:E_37 a csor:Eenheid ;
    rdfs:label "milligram"@nl .

ex:lozing-2030042 a prov:Entity,
        sosa:FeatureOfInterest,
        wk:Emissie ;
    dct:type matrix:afvalwater ;
    sosa:isFeatureOfInterestOf ex:observatie-brutovracht-2030042-2009-PAS_2521,
        ex:observatie-brutovracht-2030042-2017-PAS_2529,
        ex:observatie-brutovracht-2030042-2022-PAS_2525 .

ex:procedure-bruto-vracht a sosa:ObservingProcedure,
        sosa:Procedure ;
    rdfs:label "Berekening bruto vracht: concentratie × debiet over de periode"@nl ;
    rdfs:comment "Bruto vracht (mg) = concentratie (µg/L) × debiet (m³). Nagekeken op alle rijen van 251013. Concentratie en debiet zijn de 'OG'-waarden van de bron."@nl ;
    sosa:hasInput csor-kwa:KWA_1,
        csor-kwa:KWA_10 ;
    sosa:hasOutput csor-kwa:KWA_5 .

