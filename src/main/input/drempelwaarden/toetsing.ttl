# toetsing.ttl — toets van een jaarvracht aan de rapporteringsdrempels (datavoorbeeld drempelwaarden)
#
# De jaarvracht zink van lozingspunt LP01 van AGC Glass Europe, vestiging Mol (2021) komt uit
# ../riepr/riepr_herzien.ttl. Hier: de jaarvracht van de exploitatie als som over de lozingspunten,
# en twee toetsen aan een drempelwaarde uit drempelwaarden.ttl (E-PRTR en IMJV Water).
# Plat model, afgeleide observaties (R7, R13). IRI's onder https://example.org/drempelwaarden/ zijn
# illustratief; IRI's van IMJV en RIE-IEPR zijn overgenomen uit het riepr-voorbeeld.

@prefix csor:    <https://data.omgeving.vlaanderen.be/ns/csor#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix ex:      <https://example.org/drempelwaarden/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .

@prefix csor-eenheid:         <https://data.omgeving.vlaanderen.be/id/concept/csor/eenheid/> .
@prefix csor-parameteraspect: <https://data.omgeving.vlaanderen.be/id/concept/csor/parameteraspect/> .

### INFRASTRUCTUUR

ex:rapporteringstoepassing a sosa:Sensor , sosa:System ;
    rdfs:label "Rapporteringstoepassing (illustratief)"@nl ;
    rdfs:comment "Software die jaarvrachten optelt en aan de rapporteringsdrempels toetst. Illustratief: de bron noemt niet wie of wat de toets uitvoert."@nl ;
    sosa:implements ex:procedure-som-lozingspunten , ex:procedure-drempeltoets .

### PROCEDURE EN PROPERTIES

ex:procedure-som-lozingspunten a sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Jaarvracht van een exploitatie als som over haar lozingspunten"@nl ;
    rdfs:comment "Een rapporteringsdrempel geldt voor de exploitatie, niet voor één lozingspunt: de jaarvracht van de exploitatie is de som van de jaarvrachten van al haar lozingspunten in hetzelfde jaar."@nl ;
    sosa:hasInput csor-parameteraspect:PAS_863 ;
    sosa:hasOutput csor-parameteraspect:PAS_863 .

ex:procedure-drempeltoets a sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Toets van een jaarvracht aan een rapporteringsdrempel"@nl ;
    rdfs:comment """1. Kies de drempelwaarde met (a) een rapporteringsgroep in de gevraagde rapporteringscontext, (b) als csor:voorParameterAspect het vracht-aspect van dezelfde stof en drager, (c) een drempelwaardetype dat past bij de bestemming van de lozing (lozend: oppervlaktewater; transfer: een zuivering buiten de exploitatie) en (d) een geldigheid die het rapporteringsjaar bevat.
2. Vergelijk de jaarvracht met de drempel. De drempels voor water staan in kg (aspect 'vracht'), de jaarvracht in kg/jr (aspect 'vracht per tijd'): de vracht over het rapporteringsjaar in kg is de jaarvracht maal één jaar.
3. Het resultaat is waar als de jaarvracht groter is dan de drempel (E-PRTR, Verordening (EG) nr. 166/2006, art. 5: 'above the applicable threshold values')."""@nl ;
    sosa:hasInput csor-parameteraspect:PAS_863 , ex:prop-rapporteringsdrempel ;
    sosa:hasOutput ex:prop-boven-rapporteringsdrempel .

csor-parameteraspect:PAS_863 a sosa:Property , csor:ParameterAspect ;
    rdfs:label "Zn t (totaal in water): vracht per tijd"@nl .

ex:prop-rapporteringsdrempel a sosa:Property ;
    rdfs:label "rapporteringsdrempel"@nl ;
    skos:definition "De hoeveelheid van een parameteraspect boven welke een exploitant moet rapporteren; de waarde is een csor:Drempelwaarde uit het CSO-register."@nl .

ex:prop-boven-rapporteringsdrempel a sosa:Property ;
    rdfs:label "boven de rapporteringsdrempel"@nl ;
    skos:definition "Of de jaarvracht van een emissie de rapporteringsdrempel overschrijdt (waar of onwaar). Welke drempel, en dus welke context, stof en welk type, volgt uit de drempelwaarde die de toets als inputwaarde gebruikt."@nl .

# CSOR-eenheid: qudt:hasUnit vraagt een qudt:Unit (R3); de QUDT-mapping staat in het register.
csor-eenheid:E_12 a csor:Eenheid , qudt:Unit ;
    rdfs:label "kilogram per jaar"@nl .

### WAARNEMINGEN

# --- de lozing van de exploitatie als feature of interest (patroon emissie) ---

ex:lozing-agc-mol-2021 a prov:Entity , sosa:FeatureOfInterest ;
    rdfs:label "Lozing van afvalwater door AGC Glass Europe, vestiging Mol, in 2021 (alle lozingspunten)"@nl ;
    prov:wasAttributedTo <https://data.imjv.omgeving.vlaanderen.be/id/exploitant/0413638187> ;
    dct:hasPart <https://data.imjv.omgeving.vlaanderen.be/id/lozing/01787986000160/2400006/2021> ;
    sosa:hasProperty csor-parameteraspect:PAS_863 , ex:prop-boven-rapporteringsdrempel .

# --- jaarvracht van de exploitatie: som over de lozingspunten (R13) ---

ex:jaarvracht-zn-agc-mol-2021 a sosa:Observation ;
    rdfs:label "Jaarvracht zink AGC Glass Europe Mol 2021 (alle lozingspunten)"@nl ;
    sosa:madeBySensor ex:rapporteringstoepassing ;
    sosa:usedProcedure ex:procedure-som-lozingspunten ;
    sosa:observedProperty csor-parameteraspect:PAS_863 ;
    sosa:hasFeatureOfInterest ex:lozing-agc-mol-2021 ;
    sosa:phenomenonTime <https://data.riepr.omgeving.vlaanderen.be/id/tijd/jaar/2021> ;
    sosa:hasInputValue <https://data.imjv.omgeving.vlaanderen.be/id/result/observatie/01787986000160/2400006/lozend/chemische_stof/HCHKCACWOHOZIP-UHFFFAOYSA-N/2021> ;
    sosa:relatedObservation <https://data.imjv.omgeving.vlaanderen.be/id/observatie/01787986000160/2400006/lozend/chemische_stof/HCHKCACWOHOZIP-UHFFFAOYSA-N/2021> ;
    sosa:hasResult ex:result-jaarvracht-zn-agc-mol-2021 .

ex:result-jaarvracht-zn-agc-mol-2021 a qudt:QuantityValue ;
    qudt:numericValue 1.59612 ;
    qudt:hasUnit csor-eenheid:E_12 .

# --- toetsen aan de drempelwaarden (R13): de drempel is een inputwaarde, zoals de jaarvracht ---

ex:toets-eprtr-zn-agc-mol-2021 a sosa:Observation ;
    rdfs:label "Toets jaarvracht zink AGC Glass Europe Mol 2021 aan de E-PRTR-drempel (lozend)"@nl ;
    sosa:madeBySensor ex:rapporteringstoepassing ;
    sosa:usedProcedure ex:procedure-drempeltoets ;
    sosa:observedProperty ex:prop-boven-rapporteringsdrempel ;
    sosa:hasFeatureOfInterest ex:lozing-agc-mol-2021 ;
    sosa:phenomenonTime <https://data.riepr.omgeving.vlaanderen.be/id/tijd/jaar/2021> ;
    sosa:hasInputValue ex:result-jaarvracht-zn-agc-mol-2021 ,
        <https://data.omgeving.vlaanderen.be/id/csor/drempelwaarde/RG_5/PAS_862/RDT_1/2007> ;   # 100 kg
    sosa:relatedObservation ex:jaarvracht-zn-agc-mol-2021 ;
    sosa:hasSimpleResult false .

ex:toets-imjvwater-zn-agc-mol-2021 a sosa:Observation ;
    rdfs:label "Toets jaarvracht zink AGC Glass Europe Mol 2021 aan de IMJV Water-drempel (transfer en lozend)"@nl ;
    sosa:madeBySensor ex:rapporteringstoepassing ;
    sosa:usedProcedure ex:procedure-drempeltoets ;
    sosa:observedProperty ex:prop-boven-rapporteringsdrempel ;
    sosa:hasFeatureOfInterest ex:lozing-agc-mol-2021 ;
    sosa:phenomenonTime <https://data.riepr.omgeving.vlaanderen.be/id/tijd/jaar/2021> ;
    sosa:hasInputValue ex:result-jaarvracht-zn-agc-mol-2021 ,
        <https://data.omgeving.vlaanderen.be/id/csor/drempelwaarde/RG_23/PAS_862/RDT_3/1996> ;  # 50 kg
    sosa:relatedObservation ex:jaarvracht-zn-agc-mol-2021 ;
    sosa:hasSimpleResult false .
