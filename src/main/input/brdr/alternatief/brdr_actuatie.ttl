@prefix plan:   <https://example.org/brdr/plan/> .
@prefix var:    <https://example.org/brdr/var/> .
@prefix ent:    <https://example.org/brdr/ent/> .
@prefix inst:   <https://example.org/brdr/inst/> .
@prefix prop:   <https://example.org/brdr/prop/> .
@prefix obj:    <https://example.org/brdr/object/> .
@prefix cl:     <https://example.org/brdr/concept/> .
@prefix alt:    <https://example.org/brdr/alternatief/> .

@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix geo:    <http://www.opengis.net/ont/geosparql#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# ALTERNATIEF — de lezing van brdr zelf: elke alignering is een sosa:Actuation.
#
# Geen herziening: dit staat naast ../brdr_herzien.ttl, waarin enkel de selectie een actuatie is.
# Deze lezing volgt de metadata die brdr zelf schrijft (OnroerendErfgoed/brdr,
# brdr/descriptor.py en brdr/metadata.py, met log_metadata en add_observations):
#  - per relevante afstand een sosa:Actuation met als feature of interest het thematische object
#    ("changes": "geo:hasGeometry"), als resultaat de geometrie, en ssn:hasInput
#    brdr:relevant_distance op de procedure (de processor, standaard brdr:2024:aligner2024a);
#  - per referentiegeometrie een sosa:Observation met die geometrie als feature of interest en
#    de kandidaat als "used"; per kandidaat een observatie van "area_overlap_full".
# De vergelijking (brdr Evaluator) schrijft brdr als eigenschappen, niet als observaties; ze is
# hier gemodelleerd zoals in het hoofdmodel.
#
# Selectie: dezelfde twee kandidaten en dezelfde (illustratieve) waarden als het hoofdmodel.
# Gedeelde resources houden de IRI's van het hoofdmodel (var:, ent:, inst:, prop:, obj:, cl:);
# wat in deze lezing anders is, staat onder alt:.


# *********************************************
# PLANNING
# *********************************************

alt:plan-heraligneren a p-plan:Plan , sosa:Procedure ;
    rdfs:label "Heraligneren van een afbakening (lezing van brdr)"@nl ;
    rdfs:seeAlso <https://github.com/OnroerendErfgoed/brdr> .

# Aligneren is hier een actuerende procedure: de processor van brdr.
alt:step-aligneren a p-plan:Step , sosa:ActuatingProcedure , sosa:Procedure ;
    rdfs:label "Aligneren van de afbakening op de referentiepercelen (brdr AlignerGeometryProcessor, 2024:aligner2024a)"@nl ;
    p-plan:isStepOfPlan alt:plan-heraligneren ;
    sosa:hasInput var:relevante-afstand ;
    sosa:hasOutput var:kandidaatgeometrie .

# Het perceel is het studieobject, de kandidaat de inputwaarde.
alt:step-evaluatie a p-plan:Step , sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Overlap van een kandidaat met een referentiegeometrie (brdr: observation_procedure_area_overlap_percentage, …_full)"@nl ;
    p-plan:isStepOfPlan alt:plan-heraligneren ;
    p-plan:isPrecededBy alt:step-aligneren ;
    sosa:hasInput var:kandidaatgeometrie ;
    sosa:hasOutput var:bedekking .

alt:step-vergelijking a p-plan:Step , sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Vergelijking van de bedekkingen van een kandidaat met de formule (brdr Evaluator)"@nl ;
    p-plan:isStepOfPlan alt:plan-heraligneren ;
    p-plan:isPrecededBy alt:step-evaluatie ;
    sosa:hasInput var:bedekking , var:basisbedekking ;
    sosa:hasOutput var:evaluatieklasse .

# De keuze genereert geen nieuwe geometrie meer: ze maakt één voorgestelde wijziging geldig.
alt:step-selectie a p-plan:Step ;
    rdfs:label "Keuze van één kandidaat als geldende afbakening"@nl ;
    p-plan:isStepOfPlan alt:plan-heraligneren ;
    p-plan:isPrecededBy alt:step-vergelijking .

var:relevante-afstand a p-plan:Variable ;
    rdfs:label "Relevante afstand (brdr: relevant_distance), in meter"@nl ;
    p-plan:isVariableOfPlan alt:plan-heraligneren ;
    p-plan:isInputVarOf alt:step-aligneren .

var:kandidaatgeometrie a p-plan:Variable ;
    rdfs:label "Kandidaat voor de nieuwe afbakening (brdr: prediction)"@nl ;
    p-plan:isVariableOfPlan alt:plan-heraligneren ;
    p-plan:isOutputVarOf alt:step-aligneren ;
    p-plan:isInputVarOf alt:step-evaluatie .

var:bedekking a p-plan:Variable ;
    rdfs:label "Bedekking van een referentieperceel, in procent"@nl ;
    p-plan:isVariableOfPlan alt:plan-heraligneren ;
    p-plan:isOutputVarOf alt:step-evaluatie ;
    p-plan:isInputVarOf alt:step-vergelijking .

var:basisbedekking a p-plan:Variable ;
    rdfs:label "Bedekking van een referentieperceel door de huidige afbakening (brdr: base observation, de formule)"@nl ;
    p-plan:isVariableOfPlan alt:plan-heraligneren ;
    p-plan:isInputVarOf alt:step-vergelijking .

var:evaluatieklasse a p-plan:Variable ;
    rdfs:label "Evaluatieklasse van een kandidaat (brdr: evaluation)"@nl ;
    p-plan:isVariableOfPlan alt:plan-heraligneren ;
    p-plan:isOutputVarOf alt:step-vergelijking .


# *********************************************
# CODELIJST (gedeeld, enkel de gebruikte begrippen)
# *********************************************

cl:evaluatie a skos:ConceptScheme ;
    skos:prefLabel "Evaluatieklasse van een brdr-kandidaat"@nl .
cl:equality_by_id a skos:Concept ; skos:inScheme cl:evaluatie ;
    skos:notation "equality_by_id" ;
    skos:prefLabel "gelijk op perceelidentificatie"@nl .
cl:to_check_no_prediction a skos:Concept ; skos:inScheme cl:evaluatie ;
    skos:notation "to_check_no_prediction" ;
    skos:prefLabel "te controleren: geen overeenkomende kandidaat"@nl .


# *********************************************
# DEPLOYMENT
# *********************************************

# brdr bestaat hier uit twee systemen: de processor die aligneert (actuator) en de
# component die waarneemt (sensor). brdr zelf geeft de sensor per run een nieuwe UUID.
inst:brdr-0.9.0 a sosa:Sensor , sosa:System , prov:SoftwareAgent ;
    rdfs:label "brdr 0.9.0 (Python-bibliotheek van Onroerend Erfgoed en Athumi)"@nl ;
    sosa:implements alt:step-evaluatie , alt:step-vergelijking ;
    sosa:hasSubSystem alt:brdr-0.9.0-aligner ;
    rdfs:seeAlso <https://github.com/OnroerendErfgoed/brdr> .

alt:brdr-0.9.0-aligner a sosa:Actuator , sosa:System , prov:SoftwareAgent ;
    rdfs:label "brdr 0.9.0, AlignerGeometryProcessor"@nl ;
    sosa:implements alt:step-aligneren .

inst:dossierbehandelaar a prov:Person , prov:Agent ;
    rdfs:label "Dossierbehandelaar van Onroerend Erfgoed (illustratief)"@nl .

inst:onroerend-erfgoed a prov:Organization , prov:Agent ;
    rdfs:label "Agentschap Onroerend Erfgoed"@nl .

obj:aanduidingsobject-1 a geo:Feature , sosa:FeatureOfInterest ;
    rdfs:label "Aanduidingsobject 1 (beschermd monument, illustratief)"@nl ;
    geo:hasGeometry alt:kandidaat-1-rd2 .

alt:heralignering-adp-2024-04-15 a sosa:Deployment , prov:Activity ;
    rdfs:label "Heralignering van de aanduidingsobjecten op GRB-ADP versie 2024-04-15 (lezing van brdr)"@nl ;
    sosa:deployedSystem inst:brdr-0.9.0 , alt:brdr-0.9.0-aligner ;
    sosa:hasFeatureOfInterest obj:aanduidingsobject-1 ;
    prov:used ent:adp-2024-04-15 ;
    prov:wasAssociatedWith inst:onroerend-erfgoed ;
    prov:qualifiedAssociation [ a prov:Association ;
        prov:agent inst:onroerend-erfgoed ;
        prov:hadPlan alt:plan-heraligneren
    ] .


# *********************************************
# PROPERTIES
# *********************************************

prop:afbakening a sosa:Property ;
    rdfs:label "Afbakening (geometrie) van een aanduidingsobject"@nl .

prop:bedekking-perceel a sosa:Property ;
    rdfs:label "Bedekking van een referentieperceel door een geometrie (brdr: area_overlap_percentage)"@nl .

prop:evaluatieklasse a sosa:Property ;
    rdfs:label "Overeenkomst van een kandidaat met de formule van de huidige afbakening (brdr: evaluation)"@nl .

alt:volledig-bedekt a sosa:Property ;
    rdfs:label "Alle overlappende referentiepercelen volledig bedekt (brdr: area_overlap_full)"@nl .


# *********************************************
# EXECUTION
# *********************************************

# --- Referentiedata (gedeeld) ---

ent:adp-2018-12-01 a prov:Entity ;
    rdfs:label "GRB, administratieve percelen (ADP), versie 2018-12-01"@nl ;
    dct:issued "2018-12-01"^^xsd:date .

ent:adp-2024-04-15 a prov:Entity ;
    rdfs:label "GRB, administratieve percelen (ADP), versie 2024-04-15"@nl ;
    dct:issued "2024-04-15"^^xsd:date ;
    prov:wasRevisionOf ent:adp-2018-12-01 .

# In deze lezing zijn de perceelgeometrieën het studieobject van de evaluatie.
ent:perceel-24504D0692-00B000-2018-12-01 a geo:Geometry , prov:Entity , sosa:FeatureOfInterest ;
    dct:isPartOf ent:adp-2018-12-01 , ent:adp-2024-04-15 .

ent:perceel-24504D0693-00B000-2018-12-01 a geo:Geometry , prov:Entity , sosa:FeatureOfInterest ;
    dct:isPartOf ent:adp-2018-12-01 , ent:adp-2024-04-15 .

ent:perceel-24504D0734-00M000-2018-12-01 a geo:Geometry , prov:Entity , sosa:FeatureOfInterest ;
    dct:isPartOf ent:adp-2018-12-01 .

ent:perceel-24504D0734-00M000-2024-04-15 a geo:Geometry , prov:Entity , sosa:FeatureOfInterest ;
    dct:isPartOf ent:adp-2024-04-15 ;
    prov:wasRevisionOf ent:perceel-24504D0734-00M000-2018-12-01 .

# --- De huidige afbakening (gedeeld) ---

ent:afbakening-1-v1 a geo:Geometry , prov:Entity ;
    rdfs:label "Afbakening van aanduidingsobject 1, versie 1"@nl ;
    prov:wasInvalidatedBy alt:selectie-1-2024-04-16 ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/31370> POLYGON ((173091.231988003 174049.97385057225, 173095.97323898383 174064.57996246478, 173108.8591519013 174061.0441936764, 173109.00910644286 174060.99718317966, 173109.0370832201 174061.13273092007, 173118.13954723 174058.38636291, 173119.7700112299 174057.89445892008, 173122.61071523 174057.03737091008, 173124.81762724 174056.37151491008, 173123.69033123992 174053.0863949101, 173123.49455523 174052.5158349101, 173122.43772384527 174049.43602870268, 173122.2656912399 174048.9347789101, 173121.75554723 174047.44825091, 173118.59772323 174038.2458189, 173118.44631616247 174038.31591967345, 173118.36681860202 174038.10053674813, 173114.83099023972 174028.3573652607, 173087.88012073652 174039.43629412368, 173091.10165324152 174049.57233541954, 173091.21366357367 174049.91739950766, 173091.231988003 174049.97385057225))"^^geo:wktLiteral .

# De formule, met de perceelgeometrie van ADP 2018-12-01 als studieobject.
alt:formule-1-v1-0734 a sosa:Observation ;
    p-plan:correspondsToStep alt:step-evaluatie ;
    sosa:observedProperty prop:bedekking-perceel ;
    sosa:hasFeatureOfInterest ent:perceel-24504D0734-00M000-2018-12-01 ;
    sosa:usedProcedure alt:step-evaluatie ;
    sosa:madeBySensor inst:brdr-0.9.0 ;
    sosa:hasInputValue ent:afbakening-1-v1 ;
    sosa:hasResult alt:formule-1-v1-0734-resultaat .

alt:formule-1-v1-0734-resultaat a qudt:QuantityValue , prov:Entity ;
    p-plan:correspondsToVariable var:basisbedekking ;
    qudt:numericValue "27.14"^^xsd:decimal ; qudt:hasUnit unit:PERCENT .

# --- Parameters (gedeeld) ---

ent:relevante-afstand-1m a qudt:QuantityValue , prov:Entity ;
    p-plan:correspondsToVariable var:relevante-afstand ;
    qudt:numericValue "1.0"^^xsd:decimal ; qudt:hasUnit unit:M .

ent:relevante-afstand-2m a qudt:QuantityValue , prov:Entity ;
    p-plan:correspondsToVariable var:relevante-afstand ;
    qudt:numericValue "2.0"^^xsd:decimal ; qudt:hasUnit unit:M .

ent:od-strategie-snap-all-side a prov:Entity ;
    rdfs:label "Open domein aan beide zijden op de referentie snappen"@nl ;
    rdf:value "SNAP_ALL_SIDE" .

ent:drempel-overlap-50 a qudt:QuantityValue , prov:Entity ;
    qudt:numericValue "50"^^xsd:decimal ; qudt:hasUnit unit:PERCENT .

# --- Aligneren: een actuatie per relevante afstand ---

# Beide actuaties werken in op dezelfde eigenschap van hetzelfde object, op hetzelfde moment,
# met een ander resultaat. Welke wijziging geldt, zegt pas de selectie.
alt:aligneren-1-rd1 a sosa:Actuation , p-plan:Activity ;
    rdfs:label "Aligneren van aanduidingsobject 1 met relevante afstand 1 m"@nl ;
    p-plan:correspondsToStep alt:step-aligneren ;
    sosa:usedProcedure alt:step-aligneren ;
    sosa:madeByActuator alt:brdr-0.9.0-aligner ;
    sosa:hasFeatureOfInterest obj:aanduidingsobject-1 ;
    sosa:actsOnProperty prop:afbakening ;
    sosa:hasInputValue ent:relevante-afstand-1m ;
    prov:used ent:afbakening-1-v1 , ent:od-strategie-snap-all-side , ent:drempel-overlap-50 ,
        ent:perceel-24504D0692-00B000-2018-12-01 , ent:perceel-24504D0693-00B000-2018-12-01 ,
        ent:perceel-24504D0734-00M000-2024-04-15 ;
    sosa:resultTime "2024-04-16T00:00:12+00:00"^^xsd:dateTime ;
    sosa:hasResult alt:kandidaat-1-rd1 .

alt:aligneren-1-rd2 a sosa:Actuation , p-plan:Activity ;
    rdfs:label "Aligneren van aanduidingsobject 1 met relevante afstand 2 m"@nl ;
    p-plan:correspondsToStep alt:step-aligneren ;
    sosa:usedProcedure alt:step-aligneren ;
    sosa:madeByActuator alt:brdr-0.9.0-aligner ;
    sosa:hasFeatureOfInterest obj:aanduidingsobject-1 ;
    sosa:actsOnProperty prop:afbakening ;
    sosa:hasInputValue ent:relevante-afstand-2m ;
    prov:used ent:afbakening-1-v1 , ent:od-strategie-snap-all-side , ent:drempel-overlap-50 ,
        ent:perceel-24504D0692-00B000-2018-12-01 , ent:perceel-24504D0693-00B000-2018-12-01 ,
        ent:perceel-24504D0734-00M000-2024-04-15 ;
    sosa:resultTime "2024-04-16T00:00:12+00:00"^^xsd:dateTime ;
    sosa:hasResult alt:kandidaat-1-rd2 .

# brdr geeft het resultaat een urn:uuid uit de hash van de geometrie (urn_from_geom):
# deterministisch, dus een stabiele IRI (R10). Hier een leesbare IRI.
alt:kandidaat-1-rd1 a geo:Geometry , prov:Entity , sosa:FeatureOfInterest ;
    rdfs:label "Voorgestelde afbakening van aanduidingsobject 1, relevante afstand 1 m"@nl ;
    p-plan:correspondsToVariable var:kandidaatgeometrie ;
    prov:wasDerivedFrom ent:afbakening-1-v1 ;
    prov:wasInvalidatedBy alt:selectie-1-2024-04-16 ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/31370> POLYGON ((173091.23 174049.97, 173095.97 174064.58, 173108.86 174061.04, 173118.14 174058.39, 173124.82 174056.37, 173122.27 174048.93, 173118.60 174038.25, 173114.83 174028.36, 173087.88 174039.44, 173091.23 174049.97))"^^geo:wktLiteral .

# De gekozen kandidaat is zelf de nieuwe afbakening: geen aparte versie.
alt:kandidaat-1-rd2 a geo:Geometry , prov:Entity , sosa:FeatureOfInterest ;
    rdfs:label "Afbakening van aanduidingsobject 1, relevante afstand 2 m (gekozen)"@nl ;
    p-plan:correspondsToVariable var:kandidaatgeometrie ;
    prov:wasDerivedFrom ent:afbakening-1-v1 ;
    prov:wasRevisionOf ent:afbakening-1-v1 ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/31370> POLYGON ((173091.23 174049.97, 173095.97 174064.58, 173108.86 174061.04, 173118.14 174058.39, 173124.82 174056.37, 173122.27 174048.93, 173118.60 174038.25, 173115.31 174028.12, 173087.95 174039.22, 173091.23 174049.97))"^^geo:wktLiteral .

# --- Evaluatie: het perceel als studieobject ---

# Enkel perceel 0734 uitgeschreven; 0692 en 0693 (100 %) volgen hetzelfde patroon.
alt:evaluatie-1-rd1-0734 a sosa:Observation ;
    p-plan:correspondsToStep alt:step-evaluatie ;
    sosa:observedProperty prop:bedekking-perceel ;
    sosa:hasFeatureOfInterest ent:perceel-24504D0734-00M000-2024-04-15 ;
    sosa:usedProcedure alt:step-evaluatie ;
    sosa:madeBySensor inst:brdr-0.9.0 ;
    sosa:hasInputValue alt:kandidaat-1-rd1 ;
    sosa:resultTime "2024-04-16T00:00:12+00:00"^^xsd:dateTime ;
    sosa:hasResult alt:bedekking-1-rd1-0734 .

alt:bedekking-1-rd1-0734 a qudt:QuantityValue , prov:Entity ;
    p-plan:correspondsToVariable var:bedekking ;
    qudt:numericValue "24.80"^^xsd:decimal ; qudt:hasUnit unit:PERCENT .

alt:evaluatie-1-rd2-0734 a sosa:Observation ;
    p-plan:correspondsToStep alt:step-evaluatie ;
    sosa:observedProperty prop:bedekking-perceel ;
    sosa:hasFeatureOfInterest ent:perceel-24504D0734-00M000-2024-04-15 ;
    sosa:usedProcedure alt:step-evaluatie ;
    sosa:madeBySensor inst:brdr-0.9.0 ;
    sosa:hasInputValue alt:kandidaat-1-rd2 ;
    sosa:resultTime "2024-04-16T00:00:12+00:00"^^xsd:dateTime ;
    sosa:hasResult alt:bedekking-1-rd2-0734 .

alt:bedekking-1-rd2-0734 a qudt:QuantityValue , prov:Entity ;
    p-plan:correspondsToVariable var:bedekking ;
    qudt:numericValue "27.14"^^xsd:decimal ; qudt:hasUnit unit:PERCENT .

# "full" gaat bij brdr over de kandidaat, niet over een perceel: een ander studieobject in
# dezelfde evaluatie.
alt:volledig-1-rd1 a sosa:Observation ;
    p-plan:correspondsToStep alt:step-evaluatie ;
    sosa:observedProperty alt:volledig-bedekt ;
    sosa:hasFeatureOfInterest alt:kandidaat-1-rd1 ;
    sosa:usedProcedure alt:step-evaluatie ;
    sosa:madeBySensor inst:brdr-0.9.0 ;
    sosa:resultTime "2024-04-16T00:00:12+00:00"^^xsd:dateTime ;
    sosa:hasSimpleResult false .

alt:volledig-1-rd2 a sosa:Observation ;
    p-plan:correspondsToStep alt:step-evaluatie ;
    sosa:observedProperty alt:volledig-bedekt ;
    sosa:hasFeatureOfInterest alt:kandidaat-1-rd2 ;
    sosa:usedProcedure alt:step-evaluatie ;
    sosa:madeBySensor inst:brdr-0.9.0 ;
    sosa:resultTime "2024-04-16T00:00:12+00:00"^^xsd:dateTime ;
    sosa:hasSimpleResult false .

# --- Vergelijking met de formule (zoals in het hoofdmodel) ---

alt:vergelijking-1-rd1 a sosa:Observation ;
    p-plan:correspondsToStep alt:step-vergelijking ;
    sosa:usedProcedure alt:step-vergelijking ;
    sosa:madeBySensor inst:brdr-0.9.0 ;
    sosa:observedProperty prop:evaluatieklasse ;
    sosa:hasFeatureOfInterest alt:kandidaat-1-rd1 ;
    sosa:hasInputValue alt:bedekking-1-rd1-0734 , alt:formule-1-v1-0734-resultaat ;
    sosa:relatedObservation alt:evaluatie-1-rd1-0734 , alt:formule-1-v1-0734 ;
    sosa:resultTime "2024-04-16T00:00:12+00:00"^^xsd:dateTime ;
    sosa:hasResult alt:evaluatieklasse-1-rd1 .

alt:evaluatieklasse-1-rd1 a prov:Entity ;
    p-plan:correspondsToVariable var:evaluatieklasse ;
    rdf:value cl:to_check_no_prediction .

alt:vergelijking-1-rd2 a sosa:Observation ;
    p-plan:correspondsToStep alt:step-vergelijking ;
    sosa:usedProcedure alt:step-vergelijking ;
    sosa:madeBySensor inst:brdr-0.9.0 ;
    sosa:observedProperty prop:evaluatieklasse ;
    sosa:hasFeatureOfInterest alt:kandidaat-1-rd2 ;
    sosa:hasInputValue alt:bedekking-1-rd2-0734 , alt:formule-1-v1-0734-resultaat ;
    sosa:relatedObservation alt:evaluatie-1-rd2-0734 , alt:formule-1-v1-0734 ;
    sosa:resultTime "2024-04-16T00:00:12+00:00"^^xsd:dateTime ;
    sosa:hasResult alt:evaluatieklasse-1-rd2 .

alt:evaluatieklasse-1-rd2 a prov:Entity ;
    p-plan:correspondsToVariable var:evaluatieklasse ;
    rdf:value cl:equality_by_id .

# --- Selectie: een PROV-activiteit die één voorstel geldig maakt ---

# Ze genereert niets: ze maakt de vorige afbakening en de niet gekozen kandidaat ongeldig
# (prov:wasInvalidatedBy hierboven); het object krijgt de gekozen kandidaat als geometrie.
alt:selectie-1-2024-04-16 a p-plan:Activity , prov:Activity ;
    rdfs:label "Keuze van kandidaat rd2 als geldende afbakening van aanduidingsobject 1"@nl ;
    p-plan:correspondsToStep alt:step-selectie ;
    prov:used alt:kandidaat-1-rd1 , alt:kandidaat-1-rd2 ,
        alt:evaluatieklasse-1-rd1 , alt:evaluatieklasse-1-rd2 ;
    prov:wasAssociatedWith inst:dossierbehandelaar ;
    prov:endedAtTime "2024-04-16T00:00:12+00:00"^^xsd:dateTime .
