###############################################################################
### WAARNEMINGEN: geurmelding
###############################################################################
# Eén melding = één collectie met drie waarnemingen. De resultaten zijn begrippen uit de codelijsten.
# De leden erven melder, procedure en tijd van de collectie (SOSA 2023, R2); het studieobject staat er
# ook expliciet op, omdat de uit de OWL-restricties gegenereerde shape het per waarneming vereist.

ex:melding-M0042-20261105-1 a sosa:ObservationCollection , sosa:ExecutionCollection ;
    rdfs:label "Geurmelding M0042-20261105-1"@nl ;
    sosa:madeBySensor ex:melder-M0042 ;
    sosa:usedProcedure ex:procedure-geurmelding ;
    sosa:hasFeatureOfInterest ex:meldplaats-M0042 ;
    sosa:phenomenonTime ex:instant-20261105T2218 ;
    sosa:resultTime "2026-11-05T22:19:37+01:00"^^xsd:dateTime ;
    sosa:hasMember ex:obs-M0042-20261105-1-soort , ex:obs-M0042-20261105-1-intensiteit , ex:obs-M0042-20261105-1-toon .

ex:obs-M0042-20261105-1-soort a sosa:Observation , sosa:Execution ;
    sosa:hasFeatureOfInterest ex:meldplaats-M0042 ;
    sosa:observedProperty ex:prop-geursoort ;
    sosa:hasResult ex:geursoort-voeding .

ex:obs-M0042-20261105-1-intensiteit a sosa:Observation , sosa:Execution ;
    sosa:hasFeatureOfInterest ex:meldplaats-M0042 ;
    sosa:observedProperty ex:prop-geurintensiteit ;
    sosa:hasResult ex:geurintensiteit-4 .

ex:obs-M0042-20261105-1-toon a sosa:Observation , sosa:Execution ;
    sosa:hasFeatureOfInterest ex:meldplaats-M0042 ;
    sosa:observedProperty ex:prop-hedonische-toon ;
    sosa:hasResult ex:hedonische-toon-min3 .

###############################################################################
### AFGELEIDE WAARNEMINGEN
###############################################################################
# R7, R13: hasInputValue naar de resultaten, relatedObservation naar de waarnemingen, geen lid van de
# broncollectie, alle vereiste eigenschappen expliciet.

# 1. Geschatte geurconcentratie op het meetpunt
ex:obs-G01-20261105T2214-geurconcentratie a sosa:Observation , sosa:Execution ;
    rdfs:label "Geschatte geurconcentratie G01, 2026-11-05 22:14–22:17"@nl ;
    sosa:madeBySensor ex:kalibratiemodel ;
    sosa:usedProcedure ex:procedure-kalibratie ;
    sosa:observedProperty ex:prop-geurconcentratie ;
    sosa:hasFeatureOfInterest ex:meetpunt-G01 ;
    sosa:phenomenonTime ex:interval-20261105T2214-2217 ;
    sosa:hasInputValue ex:result-G01-20261105T2214 , ex:result-G01-20261105T2215 , ex:result-G01-20261105T2216 ;
    sosa:relatedObservation ex:obs-G01-20261105T2214 , ex:obs-G01-20261105T2215 , ex:obs-G01-20261105T2216 ;
    sosa:hasResult ex:result-G01-20261105T2214-geurconcentratie .

