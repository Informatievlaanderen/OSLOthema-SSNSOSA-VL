ex:obs-W01-20261105T2210-richting a sosa:Observation , sosa:Execution ;
    sosa:madeBySensor ex:windsensor-W01 ;
    sosa:usedProcedure ex:procedure-wind ;
    sosa:observedProperty ex:prop-windrichting ;
