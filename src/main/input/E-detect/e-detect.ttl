###############################################################################
### WAARNEMINGEN: geursensor G01
###############################################################################
# Minuutwaarden van de sensorrespons. Dimensieloos (unit:UNITLESS), maar wel een resultaatobject: de
# geschatte geurconcentratie verwijst ernaar met sosa:hasInputValue (R7), wat met een literal niet kan.

ex:collectie-G01-20261105T22 a sosa:ObservationCollection , sosa:ExecutionCollection ;
    rdfs:label "Sensorrespons G01, 2026-11-05 22:14–22:17"@nl ;
    sosa:madeBySensor ex:geursensor-G01 ;
    sosa:usedProcedure ex:procedure-enose ;
    sosa:observedProperty ex:prop-sensorrespons ;
    sosa:hasFeatureOfInterest ex:meetpunt-G01 ;
    sosa:hasMember ex:obs-G01-20261105T2214 , ex:obs-G01-20261105T2215 , ex:obs-G01-20261105T2216 .

ex:obs-G01-20261105T2214 a sosa:Observation , sosa:Execution ;
    sosa:madeBySensor ex:geursensor-G01 ;
    sosa:usedProcedure ex:procedure-enose ;
    sosa:observedProperty ex:prop-sensorrespons ;
    sosa:hasFeatureOfInterest ex:meetpunt-G01 ;
    sosa:phenomenonTime ex:interval-20261105T2214 ;
    sosa:hasResult ex:result-G01-20261105T2214 .
ex:result-G01-20261105T2214 a qudt:QuantityValue ;
    qudt:numericValue 0.41 ;
    qudt:hasUnit unit:UNITLESS .

ex:obs-G01-20261105T2215 a sosa:Observation , sosa:Execution ;
    sosa:madeBySensor ex:geursensor-G01 ;
    sosa:usedProcedure ex:procedure-enose ;
    sosa:observedProperty ex:prop-sensorrespons ;
    sosa:hasFeatureOfInterest ex:meetpunt-G01 ;
    sosa:phenomenonTime ex:interval-20261105T2215 ;
    sosa:hasResult ex:result-G01-20261105T2215 .
ex:result-G01-20261105T2215 a qudt:QuantityValue ;
    qudt:numericValue 0.58 ;
    qudt:hasUnit unit:UNITLESS .

ex:obs-G01-20261105T2216 a sosa:Observation , sosa:Execution ;
    sosa:madeBySensor ex:geursensor-G01 ;
    sosa:usedProcedure ex:procedure-enose ;
    sosa:observedProperty ex:prop-sensorrespons ;
    sosa:hasFeatureOfInterest ex:meetpunt-G01 ;
    sosa:phenomenonTime ex:interval-20261105T2216 ;
    sosa:hasResult ex:result-G01-20261105T2216 .
ex:result-G01-20261105T2216 a qudt:QuantityValue ;
    qudt:numericValue 0.52 ;
    qudt:hasUnit unit:UNITLESS .

