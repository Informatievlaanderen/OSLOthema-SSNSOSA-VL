###############################################################################
### MEETLOCATIES
###############################################################################
# Ruimtelijk monster van de omgeving van een bron (R11), met het adres uit de registratie
# (prov:atLocation) en een geometrie (geo:hasGeometry). De geometrie is fictief: afgeleid uit het
# gepseudonimiseerde adres, niet uit een echte positie.

ex:meetlocatie-1890-gwionstraat-39 a sosa:Platform , sosa:FeatureOfInterest , sosa:SpatialSample , sosa:Sample ;
    rdfs:label "Meetlocatie Gwionstraat 39, 1890 Verdoemenisveld"@nl ;
    rdfs:comment "De plaats waar de ELF-meter opgesteld staat en waar de blootstelling aan het magnetische veld bestudeerd wordt."@nl ;
    sosa:isSampleOf ex:omgeving-verbinding-verdoemenisveld ;
    sosa:isResultOf ex:sampling-meetlocatie-1890-gwionstraat-39 ;
    prov:atLocation ex:adres-1890-gwionstraat-39 ;
    geo:hasGeometry ex:geom-1890-gwionstraat-39 ;
    sosa:hasProperty ex:prop-RMStotal , ex:prop-Xpeak_low , ex:prop-Ypeak_low , ex:prop-Zpeak_low , ex:prop-Xpeak_high , ex:prop-Ypeak_high , ex:prop-Zpeak_high ;
    sosa:inDeployment ex:meetcampagne-SENS-320 .

ex:sampling-meetlocatie-1890-gwionstraat-39 a sosa:Sampling , sosa:Execution ;
    rdfs:label "Keuze van meetlocatie Gwionstraat 39, 1890 Verdoemenisveld in de omgeving van 380 kV-verbinding bij Verdoemenisveld (fictief)"@nl ;
    sosa:hasFeatureOfInterest ex:omgeving-verbinding-verdoemenisveld ;
    sosa:hasResult ex:meetlocatie-1890-gwionstraat-39 .

ex:adres-1890-gwionstraat-39 a prov:Location ;
    rdfs:label "Gwionstraat 39, 1890 Verdoemenisveld"@nl .

ex:geom-1890-gwionstraat-39 a geo:Geometry ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/31370> POINT(42604 170080)"^^geo:wktLiteral ;
    rdfs:comment "Fictief punt, afgeleid uit het gepseudonimiseerde adres. In productie: de exacte locatie uit de registratie, of de adrespositie uit het Adressenregister."@nl .

ex:meetlocatie-2256-draconisstraat-8a a sosa:Platform , sosa:FeatureOfInterest , sosa:SpatialSample , sosa:Sample ;
    rdfs:label "Meetlocatie Draconisstraat 8a, 2256 Ravenklauwbeke"@nl ;
    rdfs:comment "De plaats waar de ELF-meter opgesteld staat en waar de blootstelling aan het magnetische veld bestudeerd wordt."@nl ;
    sosa:isSampleOf ex:omgeving-verbinding-ravenklauwbeke ;
    sosa:isResultOf ex:sampling-meetlocatie-2256-draconisstraat-8a ;
    prov:atLocation ex:adres-2256-draconisstraat-8a ;
    geo:hasGeometry ex:geom-2256-draconisstraat-8a ;
    sosa:hasProperty ex:prop-RMStotal , ex:prop-Xpeak_low , ex:prop-Ypeak_low , ex:prop-Zpeak_low , ex:prop-Xpeak_high , ex:prop-Ypeak_high , ex:prop-Zpeak_high ;
    sosa:inDeployment ex:meetcampagne-SENS-109 .

ex:sampling-meetlocatie-2256-draconisstraat-8a a sosa:Sampling , sosa:Execution ;
    rdfs:label "Keuze van meetlocatie Draconisstraat 8a, 2256 Ravenklauwbeke in de omgeving van 70 kV-verbinding bij Ravenklauwbeke (fictief)"@nl ;
    sosa:hasFeatureOfInterest ex:omgeving-verbinding-ravenklauwbeke ;
    sosa:hasResult ex:meetlocatie-2256-draconisstraat-8a .

ex:adres-2256-draconisstraat-8a a prov:Location ;
    rdfs:label "Draconisstraat 8a, 2256 Ravenklauwbeke"@nl .

