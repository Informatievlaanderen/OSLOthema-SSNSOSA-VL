# Gegenereerd door scripts/elf_to_rdf.py — niet met de hand wijzigen.
# Validatie-subset: meetcampagnes SENS-269, SENS-270, SENS-229, minuutwaarden van ELF_C_0020 van 2025-11-27 10:00 tot 11:00 lokale tijd met de uurindicatoren.
# Gepseudonimiseerde bron; bronnen en geometrieën zijn fictief.
@prefix sosa:         <http://www.w3.org/ns/sosa/> .
@prefix prov:         <http://www.w3.org/ns/prov#> .
@prefix time:         <http://www.w3.org/2006/time#> .
@prefix qudt:         <http://qudt.org/schema/qudt/> .
@prefix unit:         <http://qudt.org/vocab/unit/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix geo:          <http://www.opengis.net/ont/geosparql#> .
@prefix dcterms:      <http://purl.org/dc/terms/> .
@prefix xsd:          <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:         <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:         <http://www.w3.org/2004/02/skos/core#> .
@prefix ex:           <https://example.org/elf/> .

###############################################################################
### INFRASTRUCTUUR
###############################################################################
# Sensoren en meetlocaties uit de registratie (Jira, project SENS). Een sensor staat niet vast op
# één locatie (ELF_C_0025 stond eerst in Bloedhoven, daarna in Duisterwijk): de koppeling loopt via de
# meetcampagne (sosa:Deployment), niet via een tijdloze sosa:hosts.

ex:sensor-ELF_C_0020 a sosa:Sensor , sosa:System ;
    rdfs:label "ELF-meter ELF_C_0020"@nl ;
    dcterms:identifier "ELF_C_0020" ;
    rdfs:comment "ELF-node die het laagfrequente magnetische veld langs drie assen meet en de waarden ongeveer elke minuut naar ThingsBoard stuurt (device_type 'elf-node')."@nl ;
    sosa:implements ex:procedure-elf-meting ;
    sosa:observes ex:prop-RMStotal , ex:prop-Xpeak_low , ex:prop-Ypeak_low , ex:prop-Zpeak_low , ex:prop-Xpeak_high , ex:prop-Ypeak_high , ex:prop-Zpeak_high ;
    sosa:hasDeployment ex:meetcampagne-SENS-269 .

ex:sensor-ELF_C_0025 a sosa:Sensor , sosa:System ;
    rdfs:label "ELF-meter ELF_C_0025"@nl ;
    dcterms:identifier "ELF_C_0025" ;
    rdfs:comment "ELF-node die het laagfrequente magnetische veld langs drie assen meet en de waarden ongeveer elke minuut naar ThingsBoard stuurt (device_type 'elf-node')."@nl ;
    sosa:implements ex:procedure-elf-meting ;
    sosa:observes ex:prop-RMStotal , ex:prop-Xpeak_low , ex:prop-Ypeak_low , ex:prop-Zpeak_low , ex:prop-Xpeak_high , ex:prop-Ypeak_high , ex:prop-Zpeak_high ;
    sosa:hasDeployment ex:meetcampagne-SENS-270 , ex:meetcampagne-SENS-229 .

###############################################################################
### BRONNEN EN HUN OMGEVING
###############################################################################
# De bron van het veld (verbinding of station) en de omgeving waarin ze het veld bepaalt, zoals de
# omgeving van de luchthaven in geluidsmeetnet/. Fictief: de registratie koppelt een sensor nog niet aan
# een bron.

ex:station-bloedhoven a sosa:FeatureOfInterest ;
    rdfs:label "Hoogspanningsstation Bloedhoven (70 kV, fictief)"@nl ;
    rdfs:comment "Fictief hoogspanningsstation (70 kV). In productie een verwijzing naar de verbinding of het station bij de netbeheerder."@nl ;
    sosa:hasProperty ex:prop-stroombelasting .

ex:omgeving-station-bloedhoven a sosa:FeatureOfInterest ;
    rdfs:label "Omgeving van Hoogspanningsstation Bloedhoven (70 kV, fictief)"@nl ;
    rdfs:comment "Het gebied waarin het magnetische veld van de bron de blootstelling bepaalt. De meetlocaties zijn ruimtelijke monsters van dit gebied."@nl ;
    prov:wasInfluencedBy ex:station-bloedhoven ;
    sosa:hasSample ex:meetlocatie-7135-mordredkaai-203 .

ex:verbinding-duisterwijk a sosa:FeatureOfInterest ;
    rdfs:label "150 kV-verbinding bij Duisterwijk (fictief)"@nl ;
    rdfs:comment "Fictieve hoogspanningsverbinding (150 kV). In productie een verwijzing naar de verbinding of het station bij de netbeheerder."@nl ;
    sosa:hasProperty ex:prop-stroombelasting .

ex:omgeving-verbinding-duisterwijk a sosa:FeatureOfInterest ;
    rdfs:label "Omgeving van 150 kV-verbinding bij Duisterwijk (fictief)"@nl ;
    rdfs:comment "Het gebied waarin het magnetische veld van de bron de blootstelling bepaalt. De meetlocaties zijn ruimtelijke monsters van dit gebied."@nl ;
    prov:wasInfluencedBy ex:verbinding-duisterwijk ;
    sosa:hasSample ex:meetlocatie-6839-obscurionweg-91 .

###############################################################################
### MEETLOCATIES
###############################################################################
# Ruimtelijk monster van de omgeving van een bron (R11), met het adres uit de registratie
# (prov:atLocation) en een geometrie (geo:hasGeometry). De geometrie is fictief: afgeleid uit het
# gepseudonimiseerde adres, niet uit een echte positie.

ex:meetlocatie-6839-obscurionweg-91 a sosa:Platform , sosa:FeatureOfInterest , sosa:SpatialSample , sosa:Sample ;
    rdfs:label "Meetlocatie Obscurionweg 91, 6839 Duisterwijk"@nl ;
    rdfs:comment "De plaats waar de ELF-meter opgesteld staat en waar de blootstelling aan het magnetische veld bestudeerd wordt."@nl ;
    sosa:isSampleOf ex:omgeving-verbinding-duisterwijk ;
    sosa:isResultOf ex:sampling-meetlocatie-6839-obscurionweg-91 ;
    prov:atLocation ex:adres-6839-obscurionweg-91 ;
    geo:hasGeometry ex:geom-6839-obscurionweg-91 ;
    sosa:hasProperty ex:prop-RMStotal , ex:prop-Xpeak_low , ex:prop-Ypeak_low , ex:prop-Zpeak_low , ex:prop-Xpeak_high , ex:prop-Ypeak_high , ex:prop-Zpeak_high ;
    sosa:inDeployment ex:meetcampagne-SENS-270 , ex:meetcampagne-SENS-269 .

ex:sampling-meetlocatie-6839-obscurionweg-91 a sosa:Sampling , sosa:Execution ;
    rdfs:label "Keuze van meetlocatie Obscurionweg 91, 6839 Duisterwijk in de omgeving van 150 kV-verbinding bij Duisterwijk (fictief)"@nl ;
    sosa:hasFeatureOfInterest ex:omgeving-verbinding-duisterwijk ;
    sosa:hasResult ex:meetlocatie-6839-obscurionweg-91 .

ex:adres-6839-obscurionweg-91 a prov:Location ;
    rdfs:label "Obscurionweg 91, 6839 Duisterwijk"@nl .

ex:geom-6839-obscurionweg-91 a geo:Geometry ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/31370> POINT(81177 208128)"^^geo:wktLiteral ;
    rdfs:comment "Fictief punt, afgeleid uit het gepseudonimiseerde adres. In productie: de exacte locatie uit de registratie, of de adrespositie uit het Adressenregister."@nl .

ex:meetlocatie-7135-mordredkaai-203 a sosa:Platform , sosa:FeatureOfInterest , sosa:SpatialSample , sosa:Sample ;
    rdfs:label "Meetlocatie Mordredkaai 203, 7135 Bloedhoven"@nl ;
    rdfs:comment "De plaats waar de ELF-meter opgesteld staat en waar de blootstelling aan het magnetische veld bestudeerd wordt."@nl ;
    sosa:isSampleOf ex:omgeving-station-bloedhoven ;
    sosa:isResultOf ex:sampling-meetlocatie-7135-mordredkaai-203 ;
    prov:atLocation ex:adres-7135-mordredkaai-203 ;
    geo:hasGeometry ex:geom-7135-mordredkaai-203 ;
    sosa:hasProperty ex:prop-RMStotal , ex:prop-Xpeak_low , ex:prop-Ypeak_low , ex:prop-Zpeak_low , ex:prop-Xpeak_high , ex:prop-Ypeak_high , ex:prop-Zpeak_high ;
    sosa:inDeployment ex:meetcampagne-SENS-229 .

ex:sampling-meetlocatie-7135-mordredkaai-203 a sosa:Sampling , sosa:Execution ;
    rdfs:label "Keuze van meetlocatie Mordredkaai 203, 7135 Bloedhoven in de omgeving van Hoogspanningsstation Bloedhoven (70 kV, fictief)"@nl ;
    sosa:hasFeatureOfInterest ex:omgeving-station-bloedhoven ;
    sosa:hasResult ex:meetlocatie-7135-mordredkaai-203 .

ex:adres-7135-mordredkaai-203 a prov:Location ;
    rdfs:label "Mordredkaai 203, 7135 Bloedhoven"@nl .

ex:geom-7135-mordredkaai-203 a geo:Geometry ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/31370> POINT(88231 178595)"^^geo:wktLiteral ;
    rdfs:comment "Fictief punt, afgeleid uit het gepseudonimiseerde adres. In productie: de exacte locatie uit de registratie, of de adrespositie uit het Adressenregister."@nl .

ex:conversiescript a sosa:Sensor , sosa:System ;
    rdfs:label "Conversiescript elf_to_rdf.py"@nl ;
    rdfs:comment "Software die de uur- en dagindicatoren berekent uit de minuutwaarden. De indicatoren staan niet in de bron; in productie berekent het dataplatform ze."@nl ;
    sosa:implements ex:procedure-minimum , ex:procedure-maximum , ex:procedure-uurgemiddelde , ex:procedure-daggemiddelde .

###############################################################################
### MEETCAMPAGNES (sosa:Deployment)
###############################################################################
# Eén Jira-ticket = één meetcampagne. Start en einde uit de registratie (enkel datums, middernacht
# lokale tijd). Een einde na de peildatum is een gepland einde en wordt niet als prov:endedAtTime
# opgenomen. Het uiteindelijke doel van de campagne is de omgeving van de bron.

ex:meetcampagne-SENS-270 a sosa:Deployment ;
    rdfs:label "Meetcampagne SENS-270: ELF_C_0025 op Obscurionweg 91, 6839 Duisterwijk"@nl ;
    dcterms:identifier "SENS-270" ;
    sosa:deployedSystem ex:sensor-ELF_C_0025 ;
    sosa:deployedOnPlatform ex:meetlocatie-6839-obscurionweg-91 ;
    sosa:hasFeatureOfInterest ex:meetlocatie-6839-obscurionweg-91 ;
    sosa:hasUltimateFeatureOfInterest ex:omgeving-verbinding-duisterwijk ;
    prov:startedAtTime "2025-11-26T00:00:00+01:00"^^xsd:dateTime ;
    prov:endedAtTime "2026-01-26T00:00:00+01:00"^^xsd:dateTime .

ex:meetcampagne-SENS-269 a sosa:Deployment ;
    rdfs:label "Meetcampagne SENS-269: ELF_C_0020 op Obscurionweg 91, 6839 Duisterwijk"@nl ;
    dcterms:identifier "SENS-269" ;
    sosa:deployedSystem ex:sensor-ELF_C_0020 ;
    sosa:deployedOnPlatform ex:meetlocatie-6839-obscurionweg-91 ;
    sosa:hasFeatureOfInterest ex:meetlocatie-6839-obscurionweg-91 ;
    sosa:hasUltimateFeatureOfInterest ex:omgeving-verbinding-duisterwijk ;
    prov:startedAtTime "2025-11-26T00:00:00+01:00"^^xsd:dateTime ;
    prov:endedAtTime "2026-01-26T00:00:00+01:00"^^xsd:dateTime .

ex:meetcampagne-SENS-229 a sosa:Deployment ;
    rdfs:label "Meetcampagne SENS-229: ELF_C_0025 op Mordredkaai 203, 7135 Bloedhoven"@nl ;
    dcterms:identifier "SENS-229" ;
    sosa:deployedSystem ex:sensor-ELF_C_0025 ;
    sosa:deployedOnPlatform ex:meetlocatie-7135-mordredkaai-203 ;
    sosa:hasFeatureOfInterest ex:meetlocatie-7135-mordredkaai-203 ;
    sosa:hasUltimateFeatureOfInterest ex:omgeving-station-bloedhoven ;
    prov:startedAtTime "2025-04-28T00:00:00+02:00"^^xsd:dateTime ;
    prov:endedAtTime "2025-09-10T00:00:00+02:00"^^xsd:dateTime .

###############################################################################
### PROCEDURE EN EIGENSCHAPPEN
###############################################################################

ex:procedure-elf-meting a sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Driedimensionale meting van het laagfrequente magnetische veld"@nl ;
    rdfs:comment "De ELF-node meet de magnetische fluxdichtheid langs drie assen en rapporteert ongeveer elke minuut zeven waarden: per as een waarde 'low' en 'high', en een totale RMS-waarde. Meetvenster, frequentieband en betekenis van 'low' en 'high' zijn niet in de bron beschreven."@nl ;
    sosa:hasOutput ex:prop-RMStotal , ex:prop-Xpeak_low , ex:prop-Ypeak_low , ex:prop-Zpeak_low , ex:prop-Xpeak_high , ex:prop-Ypeak_high , ex:prop-Zpeak_high .

ex:procedure-minimum a sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Minimum van RMStotal over een periode"@nl ;
    rdfs:comment "Kleinste inputwaarde. Voor een uur: de minuutwaarden met resultaattijd in het lokale uur [hh:00, hh+1:00). Voor een dag: de uurminima van die dag."@nl ;
    sosa:hasInput ex:prop-RMStotal ;
    sosa:hasOutput ex:prop-RMStotal .

ex:procedure-maximum a sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Maximum van RMStotal over een periode"@nl ;
    rdfs:comment "Grootste inputwaarde. Voor een uur: de minuutwaarden met resultaattijd in het lokale uur [hh:00, hh+1:00). Voor een dag: de uurmaxima van die dag."@nl ;
    sosa:hasInput ex:prop-RMStotal ;
    sosa:hasOutput ex:prop-RMStotal .

ex:procedure-uurgemiddelde a sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Uurgemiddelde van RMStotal"@nl ;
    rdfs:comment "Rekenkundig gemiddelde van de minuutwaarden met resultaattijd in het lokale uur [hh:00, hh+1:00). Ontbrekende minuten tellen niet mee; het aantal staat bij de waarneming."@nl ;
    sosa:hasInput ex:prop-RMStotal ;
    sosa:hasOutput ex:prop-RMStotal .

ex:procedure-daggemiddelde a sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Daggemiddelde van RMStotal"@nl ;
    rdfs:comment "Rekenkundig gemiddelde van de uurgemiddelden van de lokale dag: elk uur met metingen weegt even zwaar, ook als er minuten ontbreken (tijdgewogen gemiddelde). Het jaargemiddelde van de business case volgt op dezelfde manier uit de daggemiddelden."@nl ;
    sosa:hasInput ex:prop-RMStotal ;
    sosa:hasOutput ex:prop-RMStotal .

ex:prop-stroombelasting a sosa:Property ;
    rdfs:label "stroombelasting"@nl ;
    skos:definition "Elektrische stroom door de geleiders van een hoogspanningsverbinding of -station. Bepaalt het magnetische veld in de omgeving; de business case wil ze tonen als duiding bij de jaargemiddelde blootstelling. Geen data in dit voorbeeld."@nl ;
    qudt:hasQuantityKind quantitykind:ElectricCurrent .

ex:prop-RMStotal a sosa:Property ;
    rdfs:label "totale RMS-waarde van de magnetische fluxdichtheid"@nl ;
    skos:notation "RMStotal" ;
    skos:definition "Effectieve waarde (RMS) van de grootte van de magnetische fluxdichtheidsvector over de drie assen. In de bron geldt telkens RMStotal = 1,2374 × √(Xpeak_low² + Ypeak_low² + Zpeak_low²)."@nl ;
    qudt:hasQuantityKind quantitykind:MagneticFluxDensity .

ex:prop-Xpeak_low a sosa:Property ;
    rdfs:label "piekwaarde 'low' langs de X-as"@nl ;
    skos:notation "Xpeak_low" ;
    skos:definition "Component langs de X-as van de magnetische fluxdichtheid, kanaal 'low'."@nl ;
    qudt:hasQuantityKind quantitykind:MagneticFluxDensity .

ex:prop-Ypeak_low a sosa:Property ;
    rdfs:label "piekwaarde 'low' langs de Y-as"@nl ;
    skos:notation "Ypeak_low" ;
    skos:definition "Component langs de Y-as van de magnetische fluxdichtheid, kanaal 'low'."@nl ;
    qudt:hasQuantityKind quantitykind:MagneticFluxDensity .

ex:prop-Zpeak_low a sosa:Property ;
    rdfs:label "piekwaarde 'low' langs de Z-as"@nl ;
    skos:notation "Zpeak_low" ;
    skos:definition "Component langs de Z-as van de magnetische fluxdichtheid, kanaal 'low'."@nl ;
    qudt:hasQuantityKind quantitykind:MagneticFluxDensity .

ex:prop-Xpeak_high a sosa:Property ;
    rdfs:label "piekwaarde 'high' langs de X-as"@nl ;
    skos:notation "Xpeak_high" ;
    skos:definition "Component langs de X-as van de magnetische fluxdichtheid, kanaal 'high'."@nl ;
    qudt:hasQuantityKind quantitykind:MagneticFluxDensity .

ex:prop-Ypeak_high a sosa:Property ;
    rdfs:label "piekwaarde 'high' langs de Y-as"@nl ;
    skos:notation "Ypeak_high" ;
    skos:definition "Component langs de Y-as van de magnetische fluxdichtheid, kanaal 'high'."@nl ;
    qudt:hasQuantityKind quantitykind:MagneticFluxDensity .

ex:prop-Zpeak_high a sosa:Property ;
    rdfs:label "piekwaarde 'high' langs de Z-as"@nl ;
    skos:notation "Zpeak_high" ;
    skos:definition "Component langs de Z-as van de magnetische fluxdichtheid, kanaal 'high'."@nl ;
    qudt:hasQuantityKind quantitykind:MagneticFluxDensity .

###############################################################################
### OBSERVATIES
###############################################################################
# Per lokaal uur een sosa:ObservationCollection met sensor, procedure en studieobject; daarin per
# meetmoment een collectie met het resultaattijdstip (UTC, zoals ThingsBoard het geeft) en zeven
# observaties, één per sleutel. Leden erven wat de collecties vermelden (SOSA 2023, ExecutionCollection);
# sosa:hasFeatureOfInterest staat toch op elk lid, omdat de uit de OWL-restrictie op sosa:Execution
# gegenereerde SHACL de overerving niet ziet.

# --- uur 2025-11-27 10:00–11:00 lokale tijd: 60 meetmomenten ---

