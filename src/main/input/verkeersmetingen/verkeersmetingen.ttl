@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ex:     <https://example.org/verkeersmetingen/> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .

###############################################################################
### INFRASTRUCTUUR
###############################################################################

ex:meetpunt-FMN-021 a sosa:Platform, sosa:FeatureOfInterest, sosa:SpatialSample, sosa:Sample ;
    rdfs:label "Mercatorstraat"@nl ;
    rdfs:comment "Vast tweerichtingsmeetpunt op de hoek van de Mercatorstraat met de Van Den Nestlei, Antwerpen (lat 51.20910, lon 4.423123). Beheerder: Provincie Antwerpen."@nl ;
    geo:hasGeometry             [ a  geo:Geometry;
                                      geo:asWKT  "Point(4.423123 51.20910)"^^geo:wktLiteral
                                ];
    sosa:isSampleOf ex:fietsroute-F1-antwerpen ;
    sosa:isResultOf ex:sampling-meetpunt-FMN-021 ;
    sosa:isFeatureOfInterestOf ex:collectie-FMN-021-20260428 ;
    sosa:hosts ex:teller-FMN-021 .

ex:teller-FMN-021 a sosa:Sensor , sosa:System ;
    rdfs:label "Automatische teller FMN-021"@nl ;
    rdfs:comment "Automatische teller voor lichte voertuigen (fiets, step, motorfiets) in tweerichtingsverkeer."@nl ;
    sosa:isHostedBy ex:meetpunt-FMN-021 ;
    sosa:implements ex:procedure-automatisch-tellen ;
    sosa:observes ex:property-verkeersintensiteit .

ex:fietsroute-F1-antwerpen a sosa:FeatureOfInterest ;
    rdfs:label "Fietsroute F1 ter hoogte van Antwerpen-Centraal"@nl ;
    rdfs:comment "Tweerichtingsfietsroute F1 in Antwerpen, gemeten ter hoogte van het station Antwerpen-Centraal."@nl ;
    sosa:hasProperty ex:property-verkeersintensiteit ;
    sosa:hasSample ex:meetpunt-FMN-021 ;
    sosa:isFeatureOfInterestOf ex:sampling-meetpunt-FMN-021 .

# Ruimtelijke bemonstering: de keuze van het meetpunt op de fietsroute (R8, R11). Het meetpunt is er
# het resultaat van, en zo is ook de fietsroute het FOI van een uitvoering.
ex:sampling-meetpunt-FMN-021 a sosa:Sampling , sosa:Execution ;
    rdfs:label "Keuze van meetpunt FMN-021 op fietsroute F1"@nl ;
    sosa:hasFeatureOfInterest ex:fietsroute-F1-antwerpen ;
    sosa:hasResult ex:meetpunt-FMN-021 .

###############################################################################
### PROCEDURE & OBSERVEERBARE EIGENSCHAPPEN
###############################################################################

ex:procedure-automatisch-tellen a sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Automatische telmethode"@nl ;
    rdfs:comment "Detectie en telling van passerende lichte voertuigen via een geautomatiseerde teller (inductielus of radar)."@nl .

ex:property-verkeersintensiteit a sosa:Property ;
    rdfs:label "Verkeersintensiteit"@nl ;
    rdfs:comment "Absoluut aantal lichte voertuigen (fiets, step, motorfiets) dat het meetpunt in de gemeten periode passeert."@nl .

###############################################################################
### OBSERVATIES — dinsdag 28 april 2026
###############################################################################
