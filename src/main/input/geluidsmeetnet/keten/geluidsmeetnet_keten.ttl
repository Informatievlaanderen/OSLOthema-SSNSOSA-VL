# Geluidsmeetnet — de keten emissie → immissie voor één vlucht (patroon "Emissie en immissie").
# Verbindt het hoofdmodel (../geluidsmeetnet.ttl: het geluidsevent als sosa:Stimulus, de meetpost als FOI)
# met het alternatief (../alternatief/: het geluid als emissie). Beide zijn schakels van één keten:
#   vlucht ─generated→ geluidsemissie (bronzijde) ─wasDerivedFrom← geluidsevent bij een meetpost (immissie)
# Handmatig opgesteld uit ../brondata/20260929_EBBR_NoiseEvents.csv (vertrek TRA15N, vier meetposten).
# IRI's onder ex: zijn die van het hoofdmodel; nieuwe resources van de keten staan onder keten:.

@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:      <https://example.org/geluidsmeetnet/> .
@prefix keten:   <https://example.org/geluidsmeetnet/keten/> .

###############################################################################
### BRONZIJDE: de vlucht en haar geluidsemissie
###############################################################################

ex:vlucht-4853D3-20260929T045809Z a prov:Activity ;
    rdfs:label "TRA15N DEP EBBR→LEAL"@nl ;
    dcterms:identifier "TRA15N" ;
    rdfs:comment "DEP EBBR → LEAL, baan 25R, route CIV4G; radarspoor 2026-09-29 06:58:09 – 07:01:53 (lokale tijd)."@nl ;
    prov:used ex:luchtvaartuig-4853D3 .

ex:luchtvaartuig-4853D3 a prov:Entity ;
    rdfs:label "PHHXJ (B738)"@nl ;
    dcterms:identifier "4853D3" .

keten:geluidsemissie-4853D3-20260929T045809Z a prov:Entity , sosa:FeatureOfInterest ;
    rdfs:label "Geluidsemissie van vlucht TRA15N"@nl ;
    rdfs:comment "Het geluid dat de vlucht aan de bron voortbracht: één emissie per vlucht. Studieobject van brongerichte waarnemingen (geluidsvermogen, certificatieniveau van het toestel); die staan niet in de Aerovision-export. In ../alternatief/ is het geluid zoals het een meetpost bereikt de emissie; hier is dat de immissie."@nl ;
    prov:wasGeneratedBy ex:vlucht-4853D3-20260929T045809Z .

###############################################################################
### VERSPREIDING EN IMMISSIE: het geluidsevent bij elke meetpost
###############################################################################
# Elk geluidsevent is de immissie: het geluid van de vlucht zoals het een meetpost bereikte. Het is
# een afgebakende gebeurtenis die de geluidsmeter doet meten, dus ook een sosa:Stimulus (hoofdmodel).
# Vier immissies zijn afgeleid van één emissie. Voor M072 is de verspreiding uitgewerkt als activiteit
# (qualified derivation); voor de andere drie volstaat prov:wasDerivedFrom.

keten:voortplanting-M072-2-20260929T050100Z a prov:Activity ;
    rdfs:label "Geluidsvoortplanting van vlucht TRA15N naar meetpost M072"@nl ;
    rdfs:comment "Afstand van het toestel tot de meetpost op het moment van het event: 2703.1794 m (kolom 'Distance (m)'). Meteo en model staan niet in de export."@nl ;
    prov:used keten:geluidsemissie-4853D3-20260929T045809Z .

ex:geluidsevent-M072-2-20260929T050100Z a sosa:Stimulus , prov:Entity ;
    rdfs:label "Geluidsevent M072-2, maximum om 2026-09-29 07:01:43"@nl ;
    sosa:isDetectedBy ex:geluidsmeter-M072-2 ;
    prov:atLocation ex:meetpost-M072 ;
    prov:wasGeneratedBy keten:voortplanting-M072-2-20260929T050100Z ;
    prov:wasDerivedFrom keten:geluidsemissie-4853D3-20260929T045809Z ;
    prov:qualifiedDerivation keten:afleiding-M072-2-20260929T050100Z .

keten:afleiding-M072-2-20260929T050100Z a prov:Derivation ;
    prov:entity keten:geluidsemissie-4853D3-20260929T045809Z ;
    prov:hadActivity keten:voortplanting-M072-2-20260929T050100Z .

ex:geluidsmeter-F041-1 a sosa:Sensor , sosa:System ; rdfs:label "Geluidsmeter campagne F041-1"@nl .
ex:geluidsmeter-F045-1 a sosa:Sensor , sosa:System ; rdfs:label "Geluidsmeter campagne F045-1"@nl .
ex:geluidsmeter-M071-1 a sosa:Sensor , sosa:System ; rdfs:label "Geluidsmeter campagne M071-1"@nl .

ex:geluidsevent-F041-1-20260929T045911Z a sosa:Stimulus , prov:Entity ;
    rdfs:label "Geluidsevent F041-1 (06:59:11–07:00:54)"@nl ;
    rdfs:comment "Afstand van het toestel tot de meetpost: 2327.5342 m."@nl ;
    sosa:isDetectedBy ex:geluidsmeter-F041-1 ;
    prov:atLocation ex:meetpost-F041 ;
    prov:wasDerivedFrom keten:geluidsemissie-4853D3-20260929T045809Z .

ex:geluidsevent-F045-1-20260929T045946Z a sosa:Stimulus , prov:Entity ;
    rdfs:label "Geluidsevent F045-1 (06:59:46–07:01:07)"@nl ;
    rdfs:comment "Afstand van het toestel tot de meetpost: 2682.5854 m."@nl ;
    sosa:isDetectedBy ex:geluidsmeter-F045-1 ;
    prov:atLocation ex:meetpost-F045 ;
    prov:wasDerivedFrom keten:geluidsemissie-4853D3-20260929T045809Z .

ex:geluidsevent-M071-1-20260929T050018Z a sosa:Stimulus , prov:Entity ;
    rdfs:label "Geluidsevent M071-1 (07:00:18–07:01:59)"@nl ;
    rdfs:comment "Afstand van het toestel tot de meetpost: 1839.0109 m."@nl ;
    sosa:isDetectedBy ex:geluidsmeter-M071-1 ;
    prov:atLocation ex:meetpost-M071 ;
    prov:wasDerivedFrom keten:geluidsemissie-4853D3-20260929T045809Z .

###############################################################################
### ONTVANGERZIJDE: de meetpost en de gemeten immissie (M072)
###############################################################################
# Het studieobject van de metingen is de meetpost, niet de immissie: de vraag is wat de plaats te
# verduren krijgt (hoofdmodel). De eventcollectie is veroorzaakt door de immissie (sosa:wasOriginatedBy).

ex:omgeving-EBBR a sosa:FeatureOfInterest ;
    rdfs:label "Omgeving van Brussels Airport (EBBR)"@nl ;
    sosa:hasSample ex:meetpost-M072 .

ex:meetpost-M072 a sosa:Platform , sosa:FeatureOfInterest , sosa:SpatialSample , sosa:Sample ;
    rdfs:label "Meetpost M072"@nl ;
    rdfs:comment "Locatie niet in de Aerovision-export opgenomen."@nl ;
    sosa:isSampleOf ex:omgeving-EBBR ;
    sosa:hosts ex:geluidsmeter-M072-2 .

ex:geluidsmeter-M072-2 a sosa:Sensor , sosa:System ;
    rdfs:label "Geluidsmeter campagne M072-2"@nl ;
    sosa:isHostedBy ex:meetpost-M072 ;
    sosa:implements ex:procedure-eventmeting ;
    sosa:observes ex:prop-LAeq , ex:prop-LAmax , ex:prop-SEL , ex:prop-duur .

ex:procedure-eventmeting a sosa:ObservingProcedure , sosa:Procedure ;
    rdfs:label "Detectie en meting van een geluidsevent"@nl .

ex:prop-LAeq a sosa:Property ; rdfs:label "LAeq van het event"@nl .
ex:prop-LAmax a sosa:Property ; rdfs:label "LAmax van het event"@nl .
ex:prop-SEL a sosa:Property ; rdfs:label "SEL van het event"@nl .
ex:prop-duur a sosa:Property ; rdfs:label "duur van het event"@nl .

ex:eventcollectie-M072-2-20260929T050100Z a sosa:ObservationCollection , sosa:ExecutionCollection ;
    sosa:wasOriginatedBy ex:geluidsevent-M072-2-20260929T050100Z ;
    sosa:madeBySensor ex:geluidsmeter-M072-2 ;
    sosa:usedProcedure ex:procedure-eventmeting ;
    sosa:hasFeatureOfInterest ex:meetpost-M072 ;
    sosa:phenomenonTime ex:interval-M072-2-20260929T050100Z ;
    sosa:hasMember ex:obs-M072-2-20260929T050100Z-LAeq , ex:obs-M072-2-20260929T050100Z-LAmax ,
        ex:obs-M072-2-20260929T050100Z-SEL , ex:obs-M072-2-20260929T050100Z-duur .

ex:instant-20260929T050100Z a time:Instant ;
    time:inXSDDateTimeStamp "2026-09-29T07:01:00+02:00"^^xsd:dateTimeStamp .
ex:instant-20260929T050219Z a time:Instant ;
    time:inXSDDateTimeStamp "2026-09-29T07:02:19+02:00"^^xsd:dateTimeStamp .
ex:instant-20260929T050143Z a time:Instant ;
    time:inXSDDateTimeStamp "2026-09-29T07:01:43+02:00"^^xsd:dateTimeStamp .

ex:interval-M072-2-20260929T050100Z a time:Interval ;
    time:hasBeginning ex:instant-20260929T050100Z ;
    time:hasEnd ex:instant-20260929T050219Z .

ex:obs-M072-2-20260929T050100Z-LAeq a sosa:Observation , sosa:Execution ;
    sosa:observedProperty ex:prop-LAeq ;
    sosa:hasFeatureOfInterest ex:meetpost-M072 ;
    sosa:phenomenonTime ex:interval-M072-2-20260929T050100Z ;
    sosa:hasResult ex:resultaat-M072-2-20260929T050100Z-LAeq .
ex:resultaat-M072-2-20260929T050100Z-LAeq a qudt:QuantityValue ;
    qudt:numericValue 55.849304 ;
    qudt:hasUnit unit:DeciB_A .

ex:obs-M072-2-20260929T050100Z-LAmax a sosa:Observation , sosa:Execution ;
    sosa:observedProperty ex:prop-LAmax ;
    sosa:hasFeatureOfInterest ex:meetpost-M072 ;
    sosa:phenomenonTime ex:instant-20260929T050143Z ;
    sosa:hasResult ex:resultaat-M072-2-20260929T050100Z-LAmax .
ex:resultaat-M072-2-20260929T050100Z-LAmax a qudt:QuantityValue ;
    qudt:numericValue 62.34 ;
    qudt:hasUnit unit:DeciB_A .

ex:obs-M072-2-20260929T050100Z-SEL a sosa:Observation , sosa:Execution ;
    sosa:observedProperty ex:prop-SEL ;
    sosa:hasFeatureOfInterest ex:meetpost-M072 ;
    sosa:phenomenonTime ex:interval-M072-2-20260929T050100Z ;
    sosa:hasResult ex:resultaat-M072-2-20260929T050100Z-SEL .
ex:resultaat-M072-2-20260929T050100Z-SEL a qudt:QuantityValue ;
    qudt:numericValue 74.82558 ;
    qudt:hasUnit unit:DeciB_A .

ex:obs-M072-2-20260929T050100Z-duur a sosa:Observation , sosa:Execution ;
    sosa:observedProperty ex:prop-duur ;
    sosa:hasFeatureOfInterest ex:meetpost-M072 ;
    sosa:phenomenonTime ex:interval-M072-2-20260929T050100Z ;
    sosa:hasResult ex:resultaat-M072-2-20260929T050100Z-duur .
ex:resultaat-M072-2-20260929T050100Z-duur a qudt:QuantityValue ;
    qudt:numericValue 79 ;
    qudt:hasUnit unit:SEC .
