# ALTERNATIEF — het geluidsevent als emissie (wk:Emissie, prov:Entity) en als FeatureOfInterest.
#
# Zelfde vlucht als in ../geluidsmeetnet.ttl (TRA15N, Mode S 4853D3, vertrek 25R om 06:58),
# maar met de vier events die ze op vier meetposten veroorzaakte (F041-1, F045-1, M071-1, M072-2).
# Gedeelde resources (vlucht, meetposten, meters, eigenschappen, procedure, tijd) houden de
# ex:-IRI's van het hoofdmodel. Wat in dit alternatief anders getypeerd of gekoppeld wordt
# (collecties, observaties, resultaten) staat onder alt:, zodat beide modellen samen in één
# store kunnen zonder dat een observatie twee FOI's krijgt.

###############################################################################
### INFRASTRUCTUUR
###############################################################################

ex:omgeving-EBBR a sosa:FeatureOfInterest ;
    rdfs:label "Omgeving van Brussels Airport (EBBR)"@nl ;
    sosa:hasSample ex:meetpost-F041 , ex:meetpost-F045 , ex:meetpost-M071 , ex:meetpost-M072 ;
    sosa:isFeatureOfInterestOf ex:sampling-meetpost-F041 , ex:sampling-meetpost-F045 ,
        ex:sampling-meetpost-M071 , ex:sampling-meetpost-M072 .

ex:geluidsmeetnet-EBBR a sosa:System ;
    rdfs:label "Geluidsmeetnet Brussels Airport"@nl ;
    sosa:hasSubSystem ex:geluidsmeter-F041-1 , ex:geluidsmeter-F045-1 ,
        ex:geluidsmeter-M071-1 , ex:geluidsmeter-M072-2 .

ex:meetpost-F041 a sosa:Platform , sosa:SpatialSample , sosa:Sample ;
    rdfs:label "Meetpost F041"@nl ;
    rdfs:comment "Blijft een ruimtelijk monster van de omgeving, maar is in dit alternatief niet langer het FOI van de eventmetingen; die verwijzen ernaar met prov:atLocation. In het volledige model blijft de meetpost het FOI van de dagindicatoren (dan ook expliciet sosa:FeatureOfInterest)."@nl ;
    sosa:isSampleOf ex:omgeving-EBBR ;
    sosa:isResultOf ex:sampling-meetpost-F041 ;
    sosa:hosts ex:geluidsmeter-F041-1 ;
    sosa:inDeployment ex:campagne-F041-1 .

ex:sampling-meetpost-F041 a sosa:Sampling , sosa:Execution ;
    rdfs:label "Keuze van meetpost F041 in de omgeving van Brussels Airport"@nl ;
    sosa:hasFeatureOfInterest ex:omgeving-EBBR ;
    sosa:hasResult ex:meetpost-F041 .

ex:campagne-F041-1 a sosa:Deployment ;
    rdfs:label "Meetcampagne F041-1"@nl ;
    sosa:deployedSystem ex:geluidsmeter-F041-1 .

ex:geluidsmeter-F041-1 a sosa:Sensor , sosa:System ;
