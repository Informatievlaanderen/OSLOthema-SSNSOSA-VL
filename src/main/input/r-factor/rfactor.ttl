ex:sensor-rfactor  a     sosa:Sensor;
        a                sosa:System;
        a                prov:SoftwareAgent;
        rdfs:label       "Centrale R-factor berekeningsketen"@nl;
        sosa:implements  ex:procedure-rfactor;
        sosa:isHostedBy  ex:departement-omgeving;
        sosa:observes    ex:property-erosiviteit .

ex:unit-rfactor  a    qudt:Unit;
        rdfs:comment  "Eenheid van de RUSLE R-factor erosiviteitsindex (geen standaard QUDT-eenheid)."@nl;
        rdfs:label    "MJ·mm/(ha·h·jaar)" .

ex:vlaanderen  a      sosa:FeatureOfInterest;
        rdfs:comment  "Studiegebied: Vlaamse regio, Belgie. Alle meetstations zijn ruimtelijke deelmonsters van dit studieobject."@nl;
        rdfs:label    "Vlaanderen"@nl .
